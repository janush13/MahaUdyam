# ------------------------------------------------------------------
# MahaUdyam One backend — environment configuration template
# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file to version control.
# ------------------------------------------------------------------

# ---- Application ---------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Allowed frontend origin for CORS (credentials-enabled).
FRONTEND_URL=http://localhost:5173

# Optional — all three have sensible defaults and rarely need to be set.
# BODY_LIMIT=10mb
# SWAGGER_ENABLED=true
# LOG_LEVEL=verbose

# ---- Database --------------------------------------------------------
# PostgreSQL connection string. Read by both Prisma Migrate
# (prisma.config.ts) and the runtime PrismaClient (PrismaService).
# If you run `docker compose up -d postgres` from this project, the
# container's host port is 5433, not 5432 — see docker-compose.yml for why
# (a pre-existing, unrelated PostgreSQL install may already hold 5432).
DATABASE_URL=postgresql://mahaudyam:mahaudyam@localhost:5433/mahaudyam_dev

# ---- Auth ---------------------------------------------------------------
# Secrets — replace with strong, unique values per environment. Never reuse
# one secret for multiple purposes.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key used to encrypt TOTP secrets at rest — must be a base64
# string that decodes to exactly 32 bytes; the app refuses to start with
# anything else. Generate a real one for every environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The value below is correctly formatted so this template boots, but it is
# PUBLIC (it decodes to the text "REPLACE_ME_NOT_A_REAL_SECRET_KEY") — never
# use it outside a throwaway local setup. Changing the key makes previously
# enrolled TOTP secrets undecryptable, so rotate it deliberately.
MFA_ENCRYPTION_KEY=UkVQTEFDRV9NRV9OT1RfQV9SRUFMX1NFQ1JFVF9LRVk=

# Optional — all have sensible defaults.
# REFRESH_COOKIE_NAME=mahaudyam_refresh_token
# AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
# AUTH_LOCKOUT_DURATION_MINUTES=15

# ---- Storage -----------------------------------------------------------
# STORAGE_DRIVER=local uses STORAGE_LOCAL_PATH and needs nothing else.
# STORAGE_DRIVER=s3 requires every S3_* value below — only "local" has an
# implementation so far (see src/infrastructure/storage); S3 is a future
# step.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# ---- Documents (Step 9) ------------------------------------------------
# Platform ceiling for one uploaded document, in bytes (default 10 MiB, the
# Blueprint's per-document NFR). A DocumentRequirement can only lower it.
# DOCUMENT_MAX_SIZE_BYTES=10485760
# Malware scanner. Only "mock" exists: a DEVELOPMENT stand-in that flags the
# public EICAR test string and does NOT perform real antivirus scanning. Every
# document records which scanner cleared it. A real scanner (e.g. ClamAV) is a
# future adapter behind the same MalwareScanner interface.
# DOCUMENT_SCANNER=mock

# Required only when STORAGE_DRIVER=s3.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=ap-south-1
# S3_BUCKET=mahaudyam-documents
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me

# ---- AI (preparation only — no AI/RAG module is implemented yet) -------
# AI_PROVIDER=none means no AI credentials are required to run the
# backend at all — this is the default. Only set AI_PROVIDER=anthropic
# (and the two values below) once an AI feature actually needs it.
AI_PROVIDER=none
# AI_API_KEY=change-me
# AI_MODEL=change-me

# ---- SLA management (Step 12) ------------------------------------------
# No SLA duration is configured here or shipped anywhere: a timeline is set per
# workflow stage by a Department Administrator (workflow_stages.sla_days) and
# stays "not yet configured" until then (FRD 25.3, Blueprint 23.4).
# The hourly breach sweep (in-process @nestjs/schedule cron; no queue or worker).
# SLA_SWEEP_ENABLED=true
# Working days are counted in a fixed-offset calendar (default IST, +05:30) and
# skip weekends (0 = Sunday ... 6 = Saturday) and the holiday calendar.
# SLA_UTC_OFFSET_MINUTES=330
# SLA_WEEKEND_DAYS=0,6
# Optional "approaching breach" warning threshold, in percent of the working
# window elapsed (Blueprint 23.3 gives 80 only as an example). Unset = none.
# SLA_WARNING_THRESHOLD_PERCENT=80

# ---- Notifications (Step 13) -------------------------------------------
# In-app notifications are always written (the guaranteed channel; Blueprint 24).
# Optional platform-wide EMAIL / SMS mirrors: comma-separated, default none.
# There is no per-user preference yet (that screen is a later step).
# NOTIFICATION_EXTRA_CHANNELS=EMAIL,SMS
# Only the mock providers exist (Blueprint 25.2): they log a clearly marked
# "[SIMULATED ...]" line and never claim a real delivery. Any other value is
# refused at start-up.
# NOTIFICATION_EMAIL_PROVIDER=mock
# NOTIFICATION_SMS_PROVIDER=mock
# Delivery retry (Blueprint 24: exponential backoff, max 3 attempts). The base
# delay is not defined by the requirements, so it is configuration.
# NOTIFICATION_MAX_ATTEMPTS=3
# NOTIFICATION_RETRY_BASE_SECONDS=60
# The per-minute in-process retry job (no queue or worker).
# NOTIFICATION_RETRY_ENABLED=true

# ---- Compliance management (Step 14) -----------------------------------
# Obligations, first due dates and due windows are a department's explicit
# configuration in the database (never seeded, never defaulted): nothing about
# them belongs here. Only the hourly in-process job (creates the occurrences an
# ACTIVE application is missing and moves obligations UPCOMING -> DUE -> OVERDUE
# by date) can be switched off. Calendar dates use SLA_UTC_OFFSET_MINUTES.
# COMPLIANCE_SYNC_ENABLED=true

# ---- Schemes / government support (Step 16) -----------------------------
# Who may PUBLISH a drafted scheme (make it visible to applicants). FRD 34 leaves
# this open (Department Admin or a separate Legal/Compliance role - item 10 of the
# to-be-validated register), so it is configuration: a comma-separated list of
# DEPT_ADMIN, LEGAL_COMPLIANCE and / or SCHEME_OFFICER. Default DEPT_ADMIN, which
# keeps publishing separate from the Scheme Officer who drafts. Never a System
# Administrator. Schemes, eligibility rules, benefits and deadlines are the
# department's data in the database - nothing about them is configured here.
# SCHEME_PUBLISHER_ROLES=DEPT_ADMIN
