model RegulatoryDocument {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  source                   String
  documentType             String   @map("document_type")
  applicableApprovalTypeId String?  @map("applicable_approval_type_id") @db.Uuid
  uploadedBy               String   @map("uploaded_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")

  applicableApprovalType ApprovalType?       @relation(fields: [applicableApprovalTypeId], references: [id], onDelete: SetNull)
  uploader               User                @relation("RegulatoryDocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)
  versions               RegulatoryVersion[]

  @@map("regulatory_documents")
}

enum RegulatoryPublishStatus {
  DRAFT
  LEGAL_REVIEW
  APPROVED
  PUBLISHED

  @@map("regulatory_publish_status")
}

model RegulatoryVersion {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regulatoryDocumentId String                  @map("regulatory_document_id") @db.Uuid
  version              Int
  effectiveFrom        DateTime                @map("effective_from")
  effectiveTo          DateTime?               @map("effective_to")
  publishStatus        RegulatoryPublishStatus @default(DRAFT) @map("publish_status")
  summary              String?
  requirements         String?
  relatedDocuments     Json?                   @map("related_documents") @db.JsonB
  content              String

  // ---------------------------------------------------------------------
  // pgvector — DELIBERATELY NOT MODELED YET. See prisma/migrations and the
  // Step 2 report ("pgvector Implementation") for the full reasoning: the
  // embedding provider/dimension is genuinely unconfirmed (Claude has no
  // first-party embeddings endpoint; a separate provider such as Voyage AI,
  // OpenAI, or Cohere must be selected first, and each uses a different
  // vector width). The `vector` extension is enabled by this step's
  // migration so pgvector is ready in Postgres, but the `embedding` column
  // itself — and its dimension — is added in a later migration once the
  // provider is confirmed, as an `Unsupported("vector(N)")` field (Prisma
  // has no native vector type; Unsupported fields are excluded from the
  // generated Client, so nothing in application code can touch it until a
  // deliberate raw-SQL integration is written). Do not add this column with
  // a guessed dimension.
  // ---------------------------------------------------------------------

  regulatoryDocument RegulatoryDocument @relation(fields: [regulatoryDocumentId], references: [id], onDelete: Restrict)

  @@index([regulatoryDocumentId])
  @@map("regulatory_versions")
}

// ============================================================================
// SYSTEM
// ============================================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ

  @@map("notification_status")
}

/// Who a notification is FOR, which decides how it is scoped when read: an
/// APPLICANT notification is visible only while its recipient still has access
/// to the enterprise / project (owner or a live representative); an OFFICER one
/// only while the application is still inside the recipient's department /
/// assignment scope; an ACCOUNT one (e.g. a representative authorisation offer)
/// concerns the recipient personally and is always theirs.
enum NotificationAudience {
  APPLICANT
  OFFICER
  ACCOUNT

  @@map("notification_audience")
}

/// One row per recipient per channel (FRD 26.2, Blueprint 12.9 / 24). IN_APP is
/// the guaranteed channel: the row IS the delivery (status SENT, then READ).
/// EMAIL / SMS rows are optional mirrors delivered through an adapter with
/// retry. `dedupe_key` makes the creation of one event idempotent per
/// recipient and channel. The content is immutable (a database trigger); only
/// delivery state and the one-way read marker change.
model Notification {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  eventType     String               @map("event_type")
  channel       NotificationChannel
  audience      NotificationAudience
  title         String
  message       String
  /// Structured, non-sensitive facts for the client (a due date, a schedule).
  payload       Json?                @db.JsonB
  status        NotificationStatus   @default(PENDING)
  attemptCount  Int                  @default(0) @map("attempt_count")
  createdAt     DateTime             @default(now()) @map("created_at")
  sentAt        DateTime?            @map("sent_at")
  readAt        DateTime?            @map("read_at")
  dedupeKey     String               @map("dedupe_key")
  /// Delivery retry (EMAIL / SMS only): when the next attempt is due, and a
  /// short failure CODE (never provider output or message content).
  nextAttemptAt DateTime?            @map("next_attempt_at")
  failureReason String?              @map("failure_reason")
  enterpriseId  String?              @map("enterprise_id") @db.Uuid
  projectId     String?              @map("project_id") @db.Uuid
  applicationId String?              @map("application_id") @db.Uuid

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enterprise  Enterprise?          @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  application ApprovalApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([userId, channel, dedupeKey])
  @@index([userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([channel, status, nextAttemptAt])
  @@map("notifications")
}

model NotificationTemplate {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType       String              @map("event_type")
  language        String
  channel         NotificationChannel
  subjectTemplate String?             @map("subject_template")
  bodyTemplate    String              @map("body_template")

  @@unique([eventType, language, channel])
  @@map("notification_templates")
}

model AuditLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  /// Nullable alongside userId — a pre-authentication event (e.g. a failed
  /// login attempt) has no resolvable role.
  roleAtTime      String?  @map("role_at_time")
  action          String
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id") @db.Uuid
  beforeState     Json?    @map("before_state") @db.JsonB
  afterState      Json?    @map("after_state") @db.JsonB
  ipAddress       String   @map("ip_address")
  ruleVersionUsed String?  @map("rule_version_used")
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  /// Application history reads every event for a set of entity ids.
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// NULL retention_days = indefinite retention until explicitly configured
/// otherwise (FRD/TRD retention periods are TBV — see architecture analysis
/// §5). entityType is the primary key — one policy row per entity type.
model RetentionPolicy {
  entityType    String @id @map("entity_type")
  retentionDays Int?   @map("retention_days")

  @@map("retention_policy")
}

