// ============================================================================
// SLA MANAGEMENT (Step 12) - TRD 12 "SLA definition is configuration, not code",
// Blueprint 23. The DEFINITION is workflow_stages.sla_days (+ sla_pause_on_query),
// NULL until a department configures it (Blueprint 23.4 / FRD 25.3): no
// duration is ever defaulted. An SlaInstance is the runtime clock of one
// application stage, created at a documented lifecycle event and holding a
// SNAPSHOT of the configuration it started under, so a later configuration
// change never re-times an existing application.
// ============================================================================

enum SlaStatus {
  /// The stage had no configured duration when the clock would have started
  /// ("Timeline not yet configured").
  NOT_CONFIGURED
  RUNNING
  /// Paused while a query awaits the applicant (TRD 12), only where the stage
  /// is configured to pause.
  PAUSED
  COMPLETED

  @@map("sla_status")
}

/// The only pause reason the requirements define with a start and end event
/// (TRD 12: a query awaiting the applicant, resumed on the response). No other
/// reason is invented.
enum SlaPauseReason {
  QUERY_AWAITING_APPLICANT

  @@map("sla_pause_reason")
}

model SlaInstance {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String    @map("application_id") @db.Uuid
  applicationStageId String    @unique @map("application_stage_id") @db.Uuid
  status             SlaStatus
  startedAt          DateTime  @map("started_at")
  /// Snapshot of the stage's configuration at start (immutable).
  slaDays            Int?      @map("sla_days")
  pauseOnQuery       Boolean   @map("pause_on_query")
  /// started_at + sla_days working days (immutable) ...
  originalDueAt      DateTime? @map("original_due_at")
  /// ... and the deadline now: original + every completed pause (never earlier
  /// than the original).
  dueAt              DateTime? @map("due_at")
  /// Start of the pause in force; null unless PAUSED.
  pausedAt           DateTime? @map("paused_at")
  completedAt        DateTime? @map("completed_at")
  /// When a breach was first recorded (by the sweep, or at a state event that
  /// found the deadline already passed). Never cleared.
  breachedAt         DateTime? @map("breached_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  application      ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicationStage ApplicationStage    @relation(fields: [applicationStageId], references: [id], onDelete: Restrict)
  pauses           SlaPause[]

  @@index([applicationId])
  @@index([status, dueAt])
  @@map("sla_instances")
}

/// One row per pause period; a resume sets resumed_at once, nothing else ever
/// changes (a database rule). The history of a clock is the sum of these.
model SlaPause {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slaInstanceId String         @map("sla_instance_id") @db.Uuid
  reason        SlaPauseReason
  /// The query that caused the pause (one pause per query).
  queryId       String         @unique @map("query_id") @db.Uuid
  pausedAt      DateTime       @map("paused_at")
  resumedAt     DateTime?      @map("resumed_at")

  slaInstance SlaInstance      @relation(fields: [slaInstanceId], references: [id], onDelete: Restrict)
  query       ApplicationQuery @relation(fields: [queryId], references: [id], onDelete: Restrict)

  @@index([slaInstanceId])
  @@map("sla_pauses")
}

/// The working-day calendar (Blueprint 23.2 / TRD 12): NULL department =
/// state-wide, otherwise that department's own. Nothing is seeded.
model SlaHoliday {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId    String?  @map("department_id") @db.Uuid
  holidayDate     DateTime @map("holiday_date") @db.Date
  description     String
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy  User        @relation("SlaHolidayCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([departmentId, holidayDate])
  @@index([holidayDate])
  @@map("sla_holidays")
}
