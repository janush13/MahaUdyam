// ============================================================================
// MahaUdyam One — Database Schema
// Step 2: Database Foundation (schema/migration infrastructure only).
//
// No business logic, seed statutory data, or query code depends on this
// schema yet — see backend/README.md and the Step 2 execution report for
// what is and is not implemented.
//
// Naming convention: Prisma model names are PascalCase; every model maps to
// a snake_case table via @@map, and every field maps to a snake_case column
// via @map, so the database itself is 100% snake_case regardless of the
// camelCase used in application code.
//
// IDs: UUID, generated by PostgreSQL (`gen_random_uuid()`, built into core
// since PG13) rather than client-side, so rows inserted by any tool (Prisma,
// raw SQL, a future admin script) get a valid id without extra plumbing.
//
// Delete behavior: the default posture in this schema is `Restrict` on any
// relation that touches a record with independent historical/statutory
// significance (per the architecture analysis's "government records should
// not cascade-delete accidentally" rule). `Cascade` is used only for pure
// join/glue rows with no independent meaning of their own (e.g.
// RolePermission, ApplicationDocument, the two self-referencing dependency
// join tables, MfaCredential, Notification). `SetNull` is used only where
// nulling an optional FK preserves the owning row's own meaning without the
// link (e.g. AuditLog.userId, Document.documentRequirementId).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block — the connection string
// now lives in prisma.config.ts (for Migrate/introspection) and is passed
// to PrismaClient via a driver adapter at runtime (see
// src/infrastructure/prisma/prisma.service.ts). DATABASE_URL still comes
// from the environment either way; no credential is hard-coded anywhere.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// IDENTITY AND ACCESS
// ============================================================================

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  email               String    @unique
  mobile              String    @unique
  /// Nullable because the authentication standard (password vs. OTP-only
  /// passwordless) remains configurable/TBV per FRD §9.2 — do not assume a
  /// value is always present.
  passwordHash        String?   @map("password_hash")
  isVerified          Boolean   @default(false) @map("is_verified")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  /// Step 4 addition — supports the ACCOUNT_DISABLED error code (FRD §4.9's
  /// "deactivation" capability). No deactivation endpoint exists yet (that's
  /// admin-module territory); the field/check exists so login can honour it
  /// once one does.
  isActive            Boolean   @default(true) @map("is_active")
  /// Step 4 addition — account-lockout support (Blueprint §13.1:
  /// AUTH_ACCOUNT_LOCKED "after a configurable failed-attempt threshold").
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  userRoles                   UserRole[]
  mfaCredential               MfaCredential?
  refreshSessions             RefreshSession[]
  enterprisesOwned            Enterprise[]               @relation("EnterpriseOwner")
  enterpriseRepresentations   EnterpriseRepresentative[] @relation("EnterpriseRepresentativeUser")
  approvalRulesCreated        ApprovalRule[]             @relation("ApprovalRuleCreatedBy")
  discoverySnapshotsCreated   DiscoverySnapshot[]        @relation("DiscoverySnapshotCreatedBy")
  applicationsCreated         ApprovalApplication[]      @relation("ApplicationCreatedBy")
  applicationsSubmitted       ApprovalApplication[]      @relation("ApplicationSubmittedBy")
  assignmentsAsOfficer        ApplicationAssignment[]    @relation("AssignmentOfficer")
  assignmentsMade             ApplicationAssignment[]    @relation("AssignmentAssignedBy")
  assignmentsEnded            ApplicationAssignment[]    @relation("AssignmentEndedBy")
  scrutinyObservations        ScrutinyObservation[]      @relation("ObservationAuthor")
  queriesRaised               ApplicationQuery[]         @relation("QueryRaisedBy")
  queriesResponded            ApplicationQuery[]         @relation("QueryRespondedBy")
  queriesClosed               ApplicationQuery[]         @relation("QueryClosedBy")
  recommendationsMade         ScrutinyRecommendation[]   @relation("RecommendationBy")
  decisionsMade               ApprovalDecision[]         @relation("DecisionBy")
  certificatesIssued          ApprovalCertificate[]      @relation("CertificateIssuedBy")
  documentsUploaded           Document[]                 @relation("DocumentUploadedBy")
  documentVerifications       DocumentVerification[]     @relation("DocumentVerifiedBy")
  applicationStagesAssigned   ApplicationStage[]         @relation("ApplicationStageAssignedOfficer")
  applicationTasksCreated     ApplicationTask[]          @relation("ApplicationTaskCreatedBy")
  delegationsFrom             OfficerDelegation[]        @relation("OfficerDelegationFrom")
  delegationsTo               OfficerDelegation[]        @relation("OfficerDelegationTo")
  delegationsCreated          OfficerDelegation[]        @relation("OfficerDelegationCreatedBy")
  inspectionsConducted        Inspection[]               @relation("InspectionInspector")
  inspectionsCreated          Inspection[]               @relation("InspectionCreatedBy")
  inspectionsAssigned         Inspection[]               @relation("InspectionAssignedBy")
  inspectionsConfirmed        Inspection[]               @relation("InspectionConfirmedBy")
  inspectionResultsRecorded   InspectionReport[]         @relation("InspectionResultRecordedBy")
  inspectionEvidenceUploaded  InspectionEvidence[]       @relation("InspectionEvidenceUploadedBy")
  inspectionReportsSubmitted  InspectionReportSummary[]  @relation("InspectionReportSubmittedBy")
  slaHolidaysCreated          SlaHoliday[]               @relation("SlaHolidayCreatedBy")
  inspectorConflictsDeclared  InspectorConflict[]        @relation("InspectorConflictInspector")
  inspectorConflictsReviewed  InspectorConflict[]        @relation("InspectorConflictReviewedBy")
  grievancesRaised            Grievance[]                @relation("GrievanceRaisedBy")
  grievancesAssigned          Grievance[]                @relation("GrievanceAssignedOfficer")
  grievanceUpdatesAuthored    GrievanceUpdate[]          @relation("GrievanceUpdateActor")
  regulatoryDocumentsUploaded RegulatoryDocument[]       @relation("RegulatoryDocumentUploadedBy")
  notifications               Notification[]
  auditLogs                   AuditLog[]

  complianceFulfilled ComplianceRecord[] @relation("ComplianceFulfilledBy")

  schemesCreated            Scheme[]                         @relation("SchemeCreatedBy")
  schemesPublished          Scheme[]                         @relation("SchemePublishedBy")
  schemeRulesCreated        SchemeRule[]                     @relation("SchemeRuleCreatedBy")
  schemeApplicationsCreated SchemeApplication[]              @relation("SchemeApplicationCreatedBy")
  schemeApplicationsDecided SchemeApplication[]              @relation("SchemeApplicationDecidedBy")
  schemeStatusChanges       SchemeApplicationStatusHistory[] @relation("SchemeStatusChangedBy")

  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Join table — pure relational glue between Role and Permission, no
/// independent meaning, so both FKs cascade.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  roleId       String  @map("role_id") @db.Uuid
  /// Nullable — not every role is department-scoped (e.g. Applicant, Super
  /// Admin, Auditor).
  departmentId String? @map("department_id") @db.Uuid

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@map("user_roles")
}

/// TOTP MFA credential. 1:1 with User — keyed directly by userId.
/// totpSecret stores CIPHERTEXT (AES-256-GCM, see src/modules/auth), never
/// the raw secret — the column name is inherited from Step 2 but its
/// content changed in Step 4; never log or return this field.
/// enabledAt is NULL while enrollment is pending confirmation (a row can
/// exist — secret generated — before MFA is actually active) and is set
/// only once POST /auth/mfa/confirm succeeds; `users.mfa_enabled` is the
/// authoritative "is MFA currently active" flag, flipped at the same time.
model MfaCredential {
  userId     String    @id @map("user_id") @db.Uuid
  totpSecret String    @map("totp_secret")
  enabledAt  DateTime? @map("enabled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_credentials")
}

/// Server-side refresh-token session, enabling rotation and reuse
/// detection that a pure stateless JWT cannot provide on its own. The
/// refresh token issued to the client IS a signed JWT (uses the existing
/// JWT_REFRESH_SECRET/JWT_REFRESH_EXPIRES_IN config), but the raw token is
/// never stored — only a SHA-256 hash of it, used purely for lookup.
/// familyId groups an entire rotation chain: on detected reuse (a
/// tokenHash whose row is already revoked being presented again), the
/// whole family is revoked, not just the one row, since reuse implies the
/// token may have been stolen at any point in the chain.
model RefreshSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

// ============================================================================
// DEPARTMENTS
// ----------------------------------------------------------------------------
// Not explicitly listed as its own table in the Step 2 field-by-field spec,
// but required for referential integrity: approval_types.department_id,
// workflow_stages.department_id, user_roles.department_id,
// grievances.assigned_department_id, schemes.department_id, and
// officer_delegations.department_id all reference a department, and the
// architecture analysis (and TRD §2/§23.1) both treat "Department" as its
// own entity. Kept intentionally minimal — no statutory department data is
// seeded here (see the seed script and report for why).
// ============================================================================

model Department {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  approvalTypes           ApprovalType[]
  workflowStages          WorkflowStage[]
  userRoles               UserRole[]
  grievances              Grievance[]
  schemes                 Scheme[]
  officerDelegations      OfficerDelegation[]
  applicationAssignments  ApplicationAssignment[]
  scrutinyObservations    ScrutinyObservation[]
  applicationQueries      ApplicationQuery[]
  slaHolidays             SlaHoliday[]
  scrutinyRecommendations ScrutinyRecommendation[]
  approvalDecisions       ApprovalDecision[]
  approvalCertificates    ApprovalCertificate[]

  @@map("departments")
}

// ============================================================================
// ENTERPRISE AND PROJECT
// ============================================================================

model Enterprise {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  businessType           String   @map("business_type")
  registrationNumber     String   @map("registration_number")
  /// Kept as free text (not an enum) — the exact registration format
  /// (Udyam/CIN/other) is TBV per FRD §37 #2; hard-coding a fixed set here
  /// would silently commit to an unconfirmed government standard.
  registrationNumberType String   @map("registration_number_type")
  address                String
  /// FRD §9.2 Step 4-5 lists sector/industry as mandatory enterprise data.
  sector                 String
  /// FRD §9.2: optional trade name, website and additional contact person.
  tradeName              String?  @map("trade_name")
  website                String?
  contactPersonName      String?  @map("contact_person_name")
  contactPersonMobile    String?  @map("contact_person_mobile")
  /// FRD §9.2: "an Enterprise Reference Number is generated on save" and
  /// is searchable later. Database-generated (sequence-backed) so it is
  /// unique and race-free without application-side retry logic.
  referenceNumber        String   @unique @default(dbgenerated("((('ENT-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('enterprise_reference_seq'::regclass))::text, 6, '0'::text))")) @map("reference_number")
  ownerUserId            String   @map("owner_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  owner           User                       @relation("EnterpriseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  representatives EnterpriseRepresentative[]
  projects        Project[]

  notifications Notification[]

  @@index([ownerUserId])
  @@map("enterprises")
}

enum RepresentativeScope {
  VIEW_ONLY
  PREPARE_SUBMIT
  FULL

  @@map("representative_scope")
}

enum RepresentativeStatus {
  PENDING
  ACTIVE
  REVOKED

  @@map("representative_status")
}

model EnterpriseRepresentative {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String               @map("enterprise_id") @db.Uuid
  representativeUserId String               @map("representative_user_id") @db.Uuid
  scope                RepresentativeScope
  /// Empty array = unrestricted (applies to every project under the
  /// enterprise); a non-empty array restricts the delegation to specific
  /// projects, per FRD §20.3's per-project granularity.
  scopedProjectIds     String[]             @default([]) @map("scoped_project_ids") @db.Uuid
  status               RepresentativeStatus @default(PENDING)
  authorisedAt         DateTime?            @map("authorised_at")
  expiresAt            DateTime?            @map("expires_at")
  revokedAt            DateTime?            @map("revoked_at")
  createdAt            DateTime             @default(now()) @map("created_at")

  enterprise     Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  representative User       @relation("EnterpriseRepresentativeUser", fields: [representativeUserId], references: [id], onDelete: Restrict)

  @@index([enterpriseId])
  @@index([representativeUserId])
  @@map("enterprise_representatives")
}

model Project {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId              String    @map("enterprise_id") @db.Uuid
  name                      String
  district                  String
  taluka                    String
  industrialArea            String?   @map("industrial_area")
  sectorCode                String    @map("sector_code")
  enterpriseSizeBand        String    @map("enterprise_size_band")
  investmentAmount          Decimal   @map("investment_amount") @db.Decimal(16, 2)
  employmentCount           Int       @map("employment_count")
  landStatus                String    @map("land_status")
  /// Conditional sub-object (e.g. lease term/lessor details) that only
  /// applies when landStatus = "Leased" — genuinely variable shape per FRD
  /// §9.2, hence JSONB rather than fixed columns.
  landLeaseDetails          Json?     @map("land_lease_details") @db.JsonB
  constructionStatus        String    @map("construction_status")
  productionStatus          String    @map("production_status")
  environmentalCategory     String?   @map("environmental_category")
  hazardousFlag             Boolean   @map("hazardous_flag")
  hazardousCategory         String?   @map("hazardous_category")
  projectStage              String    @map("project_stage")
  /// FRD §9.2: optional additional site details and expected commissioning
  /// date.
  additionalSiteDetails     String?   @map("additional_site_details")
  expectedCommissioningDate DateTime? @map("expected_commissioning_date") @db.Date
  /// FRD §9.2: "A Project Reference Number is generated on save" and is
  /// searchable later. Database-generated (sequence-backed), like
  /// enterprises.reference_number.
  referenceNumber           String    @unique @default(dbgenerated("((('PRJ-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('project_reference_seq'::regclass))::text, 6, '0'::text))")) @map("reference_number")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  enterprise         Enterprise            @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  applications       ApprovalApplication[]
  discoverySnapshots DiscoverySnapshot[]
  inspectorConflicts InspectorConflict[]
  schemeApplications SchemeApplication[]

  notifications Notification[]

  @@index([enterpriseId])
  @@map("projects")
}

// ============================================================================
// APPROVAL DISCOVERY
// ============================================================================

model ApprovalType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  legalName      String? @map("legal_name")
  departmentId   String  @map("department_id") @db.Uuid
  description    String?
  legalReference String? @map("legal_reference")
  isActive       Boolean @default(true) @map("is_active")

  department             Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rules                  ApprovalRule[]
  documentRequirements   DocumentRequirement[]
  workflows              Workflow[]
  applications           ApprovalApplication[]
  inspectionChecklists   InspectionChecklist[]
  complianceRequirements ComplianceRequirement[]
  regulatoryDocuments    RegulatoryDocument[]
  dependents             ApprovalDependency[]    @relation("ApprovalDependencyApprovalType")
  dependencies           ApprovalDependency[]    @relation("ApprovalDependencyDependsOnApprovalType")

  @@index([departmentId])
  @@map("approval_types")
}

model ApprovalRule {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId       String    @map("approval_type_id") @db.Uuid
  version              Int
  effectiveFrom        DateTime  @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")
  isActive             Boolean   @default(true) @map("is_active")
  /// Real database field, not a frontend-only distinction: true =
  /// "Officially Required" (department has explicitly confirmed the rule as
  /// authoritative); false (default) = "Potentially Applicable" only.
  /// See FRD §10.3 — this must never be inferred client-side.
  isOfficiallyRequired Boolean   @default(false) @map("is_officially_required")
  /// Rule condition grammar (equals/in/not_in/gt/lt/between, combined via
  /// all/any) — see the architecture analysis §12. Evaluated by the (later)
  /// discovery engine, not by this schema.
  conditions           Json      @db.JsonB
  excludesIf           Json?     @map("excludes_if") @db.JsonB
  /// Deterministic ordering of discovery results (lower first); NOT a
  /// conflict-resolution mechanism — at most one rule version is ever
  /// evaluated per approval type (the highest effective version).
  priority             Int       @default(100)
  /// Evidence for the rule: the circular / Act / department confirmation it
  /// rests on. `TBD` is the explicit marker for "department has not yet
  /// supplied a citation" — never a guessed one.
  sourceReference      String    @map("source_reference")
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  approvalType ApprovalType @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  creator      User         @relation("ApprovalRuleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  /// Versions are sequential per approval type and immutable once written
  /// (a database trigger allows only is_active / a one-time effective_to).
  @@unique([approvalTypeId, version])
  @@index([approvalTypeId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("approval_rules")
}

/// Self-referencing many-to-many on ApprovalType, expressing "this approval
/// depends on that approval" (e.g. a Fire NOC that requires Consent to
/// Establish first) — a relationship between approvals, not a rule
/// condition, per the architecture analysis §12.
model ApprovalDependency {
  approvalTypeId          String @map("approval_type_id") @db.Uuid
  dependsOnApprovalTypeId String @map("depends_on_approval_type_id") @db.Uuid

  approvalType          ApprovalType @relation("ApprovalDependencyApprovalType", fields: [approvalTypeId], references: [id], onDelete: Cascade)
  dependsOnApprovalType ApprovalType @relation("ApprovalDependencyDependsOnApprovalType", fields: [dependsOnApprovalTypeId], references: [id], onDelete: Cascade)

  @@id([approvalTypeId, dependsOnApprovalTypeId])
  @@map("approval_dependencies")
}

/// Persists exactly which rule versions fired for a project's discovery run,
/// so a historical application can always be reproduced against the rules
/// that were actually in effect at the time — required for statutory
/// defensibility (TRD §4.3) and NOT satisfiable by re-running today's rules.
model DiscoverySnapshot {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  evaluatedAt            DateTime @default(now()) @map("evaluated_at")
  /// Self-contained copy of every rule version evaluated (id, version,
  /// definition, department, approval type), so a later change to a rule,
  /// approval type or department can never rewrite this result.
  ruleVersionsUsed       Json     @map("rule_versions_used") @db.JsonB
  matchedApprovalTypeIds String[] @default([]) @map("matched_approval_type_ids") @db.Uuid
  /// The project/enterprise characteristics exactly as evaluated.
  projectInputs          Json     @map("project_inputs") @db.JsonB
  /// The full structured discovery result (applicable / not applicable, with
  /// explanations). Together with the two columns above it reproduces the
  /// evaluation exactly. Rows are immutable (database trigger).
  result                 Json     @db.JsonB
  engineVersion          String   @map("engine_version")
  createdByUserId        String?  @map("created_by_user_id") @db.Uuid

  project      Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator      User?                 @relation("DiscoverySnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  /// Applications started from this discovery result (Step 8).
  applications ApprovalApplication[]

  @@index([projectId])
  @@map("discovery_snapshots")
}

// ============================================================================
// APPLICATIONS — two-layer status model (do not merge these enums; see the
// architecture analysis §3 item #2 and §13 for why this distinction is
// mandatory: internalState is the engine-owned TRD lifecycle, applicantStatus
// is the FRD-facing vocabulary shown to the applicant, and collapsing them
// loses the "scrutiny recommends, only the Approving Authority decides"
// boundary).
// ============================================================================

/// Engine-owned technical lifecycle (TRD §3.2).
///
/// NOTE ON VALIDATION AGAINST SOURCE DOCUMENTS: the Step 2 task brief's
/// suggested state list omitted REJECTED. TRD §3.2 explicitly includes it
/// ("RECOMMENDED_FOR_APPROVAL → APPROVED ... / REJECTED → (WITHDRAWN |
/// RESUBMITTED as new version)") and the rejection→resubmission workflow
/// (FRD §17.3, TRD §3.3) is unusable without it, so it has been added back
/// in. See the Step 2 report, "Architecture Deviations", for the full
/// justification.
enum InternalApplicationState {
  DRAFT
  SUBMITTED
  UNDER_SCRUTINY
  QUERY_RAISED
  APPLICANT_RESPONDED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  RECOMMENDED_FOR_APPROVAL
  APPROVED
  REJECTED
  CERTIFICATE_ISSUED
  ACTIVE
  RENEWAL_DUE
  RENEWAL_SUBMITTED
  EXPIRED
  WITHDRAWN_BY_APPLICANT
  CANCELLED
  DUPLICATE_FLAGGED

  @@map("internal_application_state")
}

/// Applicant-facing vocabulary (FRD §11.2). NOT_STARTED is deliberately
/// excluded: it describes a checklist item for which no application row
/// exists yet (handled by the future ChecklistModule), so it can never be
/// the value of an actual approval_applications row, which only exists once
/// an application has at least reached Draft.
enum ApplicantStatus {
  DRAFT
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_SCRUTINY
  QUERY_RAISED
  AWAITING_APPLICANT
  INSPECTION_PENDING
  INSPECTION_SCHEDULED
  AWAITING_DECISION
  APPROVED
  REJECTED
  WITHDRAWN
  CLOSED
  RENEWAL_DUE

  @@map("applicant_status")
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH

  @@map("risk_band")
}

model ApprovalApplication {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId             String                   @map("project_id") @db.Uuid
  approvalTypeId        String                   @map("approval_type_id") @db.Uuid
  workflowId            String                   @map("workflow_id") @db.Uuid
  internalState         InternalApplicationState @default(DRAFT) @map("internal_state")
  applicantStatus       ApplicantStatus          @default(DRAFT) @map("applicant_status")
  previousApplicationId String?                  @map("previous_application_id") @db.Uuid
  referenceNumber       String?                  @unique @map("reference_number")
  submittedAt           DateTime?                @map("submitted_at")
  decidedAt             DateTime?                @map("decided_at")
  decisionReason        String?                  @map("decision_reason")
  riskBand              RiskBand?                @map("risk_band")
  version               Int                      @default(1)
  /// The persisted Step 7 discovery result this application was started
  /// from — a foreign key to an IMMUTABLE snapshot, so later rule changes can
  /// never alter what an application says it was based on. Nullable only
  /// because applications not born from a discovery run (a renewal, a later
  /// step) have none; the Step 8 API always sets it. Never changes after
  /// creation (database trigger).
  discoverySnapshotId   String?                  @map("discovery_snapshot_id") @db.Uuid
  /// Denormalised copy of the snapshot's entry for THIS approval (rule id +
  /// version, recommendation label, department, explanation), so "which
  /// rule/discovery context was used" is answerable from the application row
  /// alone. Recommendation only — never a statutory determination.
  discoveryContext      Json?                    @map("discovery_context") @db.JsonB
  /// The document versions that were current at submission (Step 9): id,
  /// version, requirement, filename, checksum, status. Answers "which
  /// document version was used when this was submitted" even after later
  /// replacements; frozen once set (database trigger).
  submittedDocuments    Json?                    @map("submitted_documents") @db.JsonB
  /// Approval-specific details the applicant enters (FRD §12/§13.2). Never
  /// holds enterprise/project fields — those are read from the project.
  /// Editable only while internal_state = DRAFT (FRD §17.3).
  formData              Json                     @default("{}") @map("form_data") @db.JsonB
  /// FRD §17.2: the mandatory declaration, timestamped when accepted at
  /// submission.
  declarationAcceptedAt DateTime?                @map("declaration_accepted_at")
  createdByUserId       String                   @map("created_by_user_id") @db.Uuid
  submittedByUserId     String?                  @map("submitted_by_user_id") @db.Uuid
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  project              Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approvalType         ApprovalType             @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  workflow             Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  previousApplication  ApprovalApplication?     @relation("ApplicationResubmission", fields: [previousApplicationId], references: [id], onDelete: Restrict)
  resubmissions        ApprovalApplication[]    @relation("ApplicationResubmission")
  assignments          ApplicationAssignment[]
  scrutinyObservations ScrutinyObservation[]
  queries              ApplicationQuery[]
  recommendations      ScrutinyRecommendation[]
  decision             ApprovalDecision?
  certificates         ApprovalCertificate[]
  inspections          Inspection[]
  slaInstances         SlaInstance[]
  discoverySnapshot    DiscoverySnapshot?       @relation(fields: [discoverySnapshotId], references: [id], onDelete: Restrict)
  createdBy            User                     @relation("ApplicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy          User?                    @relation("ApplicationSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  stages               ApplicationStage[]
  applicationDocuments ApplicationDocument[]
  complianceRecords    ComplianceRecord[]
  grievances           Grievance[]
  renewalsAsOriginal   Renewal[]             @relation("RenewalOriginalApplication")
  renewalsAsNew        Renewal[]             @relation("RenewalNewApplication")

  notifications Notification[]

  @@index([projectId])
  @@index([approvalTypeId])
  @@index([internalState])
  @@index([applicantStatus])
  @@index([discoverySnapshotId])
  @@index([projectId, approvalTypeId])
  /// The officer queue: a department's non-draft applications, oldest first.
  @@index([internalState, submittedAt])
  @@map("approval_applications")
}

enum ApplicationStageStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED

  @@map("application_stage_status")
}

model ApplicationStage {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String                 @map("application_id") @db.Uuid
  workflowStageId   String                 @map("workflow_stage_id") @db.Uuid
  status            ApplicationStageStatus @default(PENDING)
  startedAt         DateTime?              @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  /// Superseded by SlaInstance (Step 12), which is the single source of truth
  /// for the clock; these two columns are left unused, never written.
  slaDueAt          DateTime?              @map("sla_due_at")
  slaPausedAt       DateTime?              @map("sla_paused_at")
  assignedOfficerId String?                @map("assigned_officer_id") @db.Uuid
  version           Int                    @default(1)

  application     ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  workflowStage   WorkflowStage       @relation(fields: [workflowStageId], references: [id], onDelete: Restrict)
  assignedOfficer User?               @relation("ApplicationStageAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)

  tasks       ApplicationTask[]
  inspections Inspection[]
  slaInstance SlaInstance?

  /// One row per stage per application (Step 12: the SLA-tracked stage).
  @@unique([applicationId, workflowStageId])
  @@index([applicationId])
  @@index([assignedOfficerId])
  @@map("application_stages")
}

// ============================================================================
// OFFICER WORKSPACE + SCRUTINY (Step 10)
// ============================================================================

/// Which officer an application is assigned to (FRD 21.2 "assigned officer",
/// TRD 29.1 "officer assignment/reassignment"). History is kept: a
/// reassignment ENDS the current row and creates a new one, so who held the
/// application when is always answerable. At most one row per application is
/// active (ended_at IS NULL) - a partial unique index in the migration.
/// Stage-level assignment (ApplicationStage.assignedOfficerId) belongs to the
/// workflow engine of a later step.
model ApplicationAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String    @map("application_id") @db.Uuid
  /// The application's department at assignment time (from its approval type).
  departmentId     String    @map("department_id") @db.Uuid
  officerUserId    String    @map("officer_user_id") @db.Uuid
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  endedAt          DateTime? @map("ended_at")
  endedByUserId    String?   @map("ended_by_user_id") @db.Uuid
  endReason        String?   @map("end_reason")

  application ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department  Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  officer     User                @relation("AssignmentOfficer", fields: [officerUserId], references: [id], onDelete: Restrict)
  assignedBy  User                @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedBy     User?               @relation("AssignmentEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([officerUserId, endedAt])
  @@index([departmentId])
  @@map("application_assignments")
}

/// An officer's INTERNAL scrutiny observation (FRD 22.1: "record scrutiny
/// observations (internal, not applicant-visible unless converted into a
/// formal query)"; TRD 9: officer-only notes channel). Append-only. The
/// requirements define no finding category / severity, so none is modelled.
model ScrutinyObservation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String   @map("application_id") @db.Uuid
  departmentId      String   @map("department_id") @db.Uuid
  authorUserId      String   @map("author_user_id") @db.Uuid
  body              String
  /// Optional pointers to what the observation is about.
  relatedDocumentId String?  @map("related_document_id") @db.Uuid
  relatedField      String?  @map("related_field")
  createdAt         DateTime @default(now()) @map("created_at")

  application     ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  author          User                @relation("ObservationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  relatedDocument Document?           @relation(fields: [relatedDocumentId], references: [id], onDelete: Restrict)
  queries         ApplicationQuery[]

  @@index([applicationId, createdAt])
  @@map("scrutiny_observations")
}

/// Query lifecycle (FRD 19.2 / TRD 3.2). The requirements name no query
/// states, only the cycle "raised -> answered -> the department closes it or
/// raises a further one", so this is the minimum that records exactly that.
enum QueryStatus {
  OPEN
  RESPONDED
  CLOSED

  @@map("query_status")
}

/// The structured query / response record (FRD 19). The question is
/// immutable; the response is written once; nothing is ever edited, so
/// "neither party can dispute what was asked or said" (FRD 19.3) holds.
/// A separate table from application_tasks, which is stage-bound (stages are
/// instantiated by a later step) and carries no content columns.
model ApplicationQuery {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId       String      @map("application_id") @db.Uuid
  departmentId        String      @map("department_id") @db.Uuid
  /// 1, 2, 3... per application (TRD 3.2 query loop rounds).
  roundNumber         Int         @map("round_number")
  raisedByUserId      String      @map("raised_by_user_id") @db.Uuid
  question            String
  /// When the query was raised from an internal observation (FRD 22.1).
  sourceObservationId String?     @map("source_observation_id") @db.Uuid
  status              QueryStatus @default(OPEN)
  createdAt           DateTime    @default(now()) @map("created_at")
  responseText        String?     @map("response_text")
  respondedByUserId   String?     @map("responded_by_user_id") @db.Uuid
  respondedAt         DateTime?   @map("responded_at")
  closedByUserId      String?     @map("closed_by_user_id") @db.Uuid
  closedAt            DateTime?   @map("closed_at")

  application       ApprovalApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  raisedBy          User                 @relation("QueryRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  respondedBy       User?                @relation("QueryRespondedBy", fields: [respondedByUserId], references: [id], onDelete: Restrict)
  closedBy          User?                @relation("QueryClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  sourceObservation ScrutinyObservation? @relation(fields: [sourceObservationId], references: [id], onDelete: Restrict)
  slaPause          SlaPause?

  @@unique([applicationId, roundNumber])
  @@index([applicationId])
  @@map("application_queries")
}

/// What the scrutiny officer recommends to the Approving Authority (FRD 22.1
/// "recommend approval or rejection with a recorded reason"). A
/// RECOMMENDATION only: scrutiny never finalises a statutory outcome. The
/// decision itself is a later step. Append-only.
enum RecommendedOutcome {
  APPROVE
  REJECT

  @@map("recommended_outcome")
}

model ScrutinyRecommendation {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId       String             @map("application_id") @db.Uuid
  departmentId        String             @map("department_id") @db.Uuid
  outcome             RecommendedOutcome
  reason              String
  recommendedByUserId String             @map("recommended_by_user_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")

  application   ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  recommendedBy User                @relation("RecommendationBy", fields: [recommendedByUserId], references: [id], onDelete: Restrict)
  decision      ApprovalDecision?

  @@index([applicationId, createdAt])
  @@map("scrutiny_recommendations")
}

// ============================================================================
// APPROVAL DECISION + CERTIFICATE (Step 15)
// ============================================================================

/// The statutory outcome the Approving Authority records (FRD 4.5 "approve or
/// reject with a mandatory recorded reason"; TRD 28). Same two words as a
/// recommendation, but a different type on purpose: a recommendation is advice
/// (`RecommendedOutcome`), a decision is the statutory act.
enum DecisionOutcome {
  APPROVE
  REJECT

  @@map("decision_outcome")
}

/// THE statutory decision on an application: exactly one per application (the
/// unique key), append-only (database trigger), recorded by an Approving
/// Authority of the application's own department, and CONSUMING - never
/// editing - the scrutiny recommendation it answers. It may differ from that
/// recommendation: the recommendation is advice, the decision is the authority's
/// own. The database refuses a decision unless the application is
/// RECOMMENDED_FOR_APPROVAL and the cited recommendation is its latest.
/// Corrections of a decision (TRD 3.3 "within a defined window") are TO BE
/// VALIDATED and are not modelled.
model ApprovalDecision {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId    String          @unique @map("application_id") @db.Uuid
  /// The application's department at decision time (from its approval type).
  departmentId     String          @map("department_id") @db.Uuid
  /// The recommendation this decision answers (never altered by it).
  recommendationId String          @unique @map("recommendation_id") @db.Uuid
  outcome          DecisionOutcome
  reason           String
  decidedByUserId  String          @map("decided_by_user_id") @db.Uuid
  decidedAt        DateTime        @default(now()) @map("decided_at")

  application    ApprovalApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  department     Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  recommendation ScrutinyRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  decidedBy      User                   @relation("DecisionBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  certificates   ApprovalCertificate[]

  @@map("approval_decisions")
}

/// The record of an issued approval certificate (TRD 3.1 "Certificate
/// Issuance"; FRD 4.5 "trigger issuance of the approval document for applicant
/// download"; FRD 18.1 "certificate once issued"). The requirements define NO
/// certificate format, numbering scheme, validity period or e-sign, so none is
/// invented: the FILE is the department's own certificate document, stored by
/// the Step 9 pipeline (scanned, checksummed, immutable); the number is
/// whatever the issuing department states (optional free text, no scheme
/// imposed); the platform records who issued it, when, and against which
/// application and decision. Append-only (database trigger); one per
/// application version.
model ApprovalCertificate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String   @map("application_id") @db.Uuid
  /// 1 for the first certificate of an application. Re-issue / correction is
  /// TO BE VALIDATED and not implemented; the key is here so it can be added
  /// without rewriting history.
  version           Int      @default(1)
  decisionId        String   @map("decision_id") @db.Uuid
  departmentId      String   @map("department_id") @db.Uuid
  /// As stated by the issuing department; no numbering scheme is imposed.
  certificateNumber String?  @map("certificate_number")
  /// The certificate file: an ordinary Step 9 document (owned by the project,
  /// scanned clean), reached only through this record.
  documentId        String   @unique @map("document_id") @db.Uuid
  issuedByUserId    String   @map("issued_by_user_id") @db.Uuid
  issuedAt          DateTime @map("issued_at")
  createdAt         DateTime @default(now()) @map("created_at")

  application ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  decision    ApprovalDecision    @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  department  Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  document    Document            @relation(fields: [documentId], references: [id], onDelete: Restrict)
  issuedBy    User                @relation("CertificateIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)

  @@unique([applicationId, version])
  @@index([decisionId])
  @@map("approval_certificates")
}

enum ApplicationTaskType {
  QUERY
  CORRECTION
  REVIEW
  ESCALATION

  @@map("application_task_type")
}

/// No literal task-status vocabulary is specified in FRD/TRD/Blueprint (they
/// describe the query/response cycle functionally, not as named states) —
/// this minimal OPEN/RESOLVED/CANCELLED set is a judgment call to give the
/// column a type instead of a free-text status, kept intentionally small.
enum ApplicationTaskStatus {
  OPEN
  RESOLVED
  CANCELLED

  @@map("application_task_status")
}

model ApplicationTask {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationStageId String                @map("application_stage_id") @db.Uuid
  type               ApplicationTaskType
  /// Query-loop protection (TRD §3.2: "must have a configurable maximum
  /// round count... after which the application auto-escalates"). Business
  /// logic that reads/enforces this is a later step; the column exists now
  /// so it doesn't need to be retrofitted.
  roundNumber        Int                   @default(1) @map("round_number")
  status             ApplicationTaskStatus @default(OPEN)
  createdBy          String                @map("created_by") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  resolvedAt         DateTime?             @map("resolved_at")

  applicationStage ApplicationStage @relation(fields: [applicationStageId], references: [id], onDelete: Restrict)
  creator          User             @relation("ApplicationTaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([applicationStageId])
  @@map("application_tasks")
}

// ============================================================================
// DOCUMENTS — reusable enterprise/project-owned assets, never inherently
// owned by a single application (TRD §6.2's "Submit Once" principle).
// ============================================================================

enum DocumentOwnerType {
  ENTERPRISE
  PROJECT

  @@map("document_owner_type")
}

enum DocumentStatus {
  UPLOADED
  SCAN_PENDING
  VALIDATION_PENDING
  VERIFIED
  REJECTED
  EXPIRED

  @@map("document_status")
}

model Document {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType             DocumentOwnerType @map("owner_type")
  ownerId               String            @map("owner_id") @db.Uuid
  documentRequirementId String?           @map("document_requirement_id") @db.Uuid
  filePath              String            @map("file_path")
  checksum              String
  originalFilename      String            @map("original_filename")
  mimeType              String            @map("mime_type")
  sizeBytes             Int               @map("size_bytes")
  status                DocumentStatus    @default(UPLOADED)
  expiryDate            DateTime?         @map("expiry_date")
  version               Int               @default(1)
  replacedDocumentId    String?           @map("replaced_document_id") @db.Uuid
  /// Identifies the whole replacement chain (v1 -> v2 -> v3...): every
  /// version carries the lineage of the first. (lineage_id, version) is
  /// unique, so two concurrent replacements can never both become "v2".
  lineageId             String            @default(dbgenerated("gen_random_uuid()")) @map("lineage_id") @db.Uuid
  /// Set only after the configured malware scanner returned CLEAN. A row with
  /// no scanned_at is never served (Step 9). Infected / unscannable uploads
  /// are never stored at all, so no such row exists for them.
  scannedAt             DateTime?         @map("scanned_at")
  /// Which scanner produced the verdict (e.g. the development stand-in), so a
  /// record never implies real antivirus scanning happened when it did not.
  scannerName           String?           @map("scanner_name")
  uploadedBy            String            @map("uploaded_by") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  documentRequirement DocumentRequirement? @relation(fields: [documentRequirementId], references: [id], onDelete: SetNull)
  replacedDocument    Document?            @relation("DocumentReplacement", fields: [replacedDocumentId], references: [id], onDelete: Restrict)
  replacements        Document[]           @relation("DocumentReplacement")
  uploader            User                 @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  applicationDocuments       ApplicationDocument[]
  verifications              DocumentVerification[]
  scrutinyObservations       ScrutinyObservation[]
  complianceRecords          ComplianceRecord[]
  inspectionReports          InspectionReport[]
  inspectionEvidence         InspectionEvidence?
  approvalCertificate        ApprovalCertificate?
  schemeApplicationDocuments SchemeApplicationDocument[]

  /// A version number is unique within its chain; each storage object backs
  /// exactly one row (uploads never overwrite).
  @@unique([lineageId, version])
  @@unique([filePath])
  @@index([ownerId])
  @@index([checksum])
  @@index([expiryDate])
  @@map("documents")
}

/// Join table — many verified documents can serve many applications
/// (TRD §23.1); pure relational glue, cascades with either side.
model ApplicationDocument {
  applicationId String @map("application_id") @db.Uuid
  documentId    String @map("document_id") @db.Uuid

  application ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId])
  @@index([applicationId])
  @@index([documentId])
  @@map("application_documents")
}

model DocumentRequirement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId   String   @map("approval_type_id") @db.Uuid
  name             String
  isMandatory      Boolean  @map("is_mandatory")
  isReusable       Boolean  @default(false) @map("is_reusable")
  /// Nullable — null means "use the platform default", set explicitly only
  /// once a department confirms a different limit (FRD §37 #3, TBV).
  maxSizeBytes     Int?     @map("max_size_bytes")
  allowedMimeTypes String[] @default([]) @map("allowed_mime_types")
  description      String?

  approvalType ApprovalType @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  documents    Document[]

  @@index([approvalTypeId])
  @@map("document_requirements")
}

/// An officer's document review outcome (FRD 22.1: "mark a document Verified
/// or Rejected (with reason)"). Set only by the officer review action.
enum DocumentVerdict {
  VERIFIED
  REJECTED

  @@map("document_verdict")
}

/// Append-only: a review is never edited (database trigger).
model DocumentVerification {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String          @map("document_id") @db.Uuid
  verifiedByUserId String          @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime        @default(now()) @map("verified_at")
  /// VERIFIED or REJECTED. For REJECTED, `notes` holds the mandatory reason.
  verdict          DocumentVerdict
  notes            String?
  validUntil       DateTime?       @map("valid_until")

  document       Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  verifiedByUser User     @relation("DocumentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@map("document_verifications")
}

// ============================================================================
// WORKFLOW
// ============================================================================

model Workflow {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId String  @map("approval_type_id") @db.Uuid
  name           String
  version        Int
  isActive       Boolean @default(true) @map("is_active")

  approvalType       ApprovalType          @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  stages             WorkflowStage[]
  applications       ApprovalApplication[]
  schemeApplications SchemeApplication[]

  @@index([approvalTypeId])
  @@map("workflows")
}

enum WorkflowStageType {
  SCRUTINY
  INSPECTION
  DECISION

  @@map("workflow_stage_type")
}

model WorkflowStage {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String            @map("workflow_id") @db.Uuid
  sequenceOrder   Int               @map("sequence_order")
  name            String
  departmentId    String            @map("department_id") @db.Uuid
  stageType       WorkflowStageType @map("stage_type")
  /// NULL = "not yet configured" — never a guessed default (FRD §25.3).
  slaDays         Int?              @map("sla_days")
  /// Per-approval-type configuration flag, defaulting to false, because
  /// TRD §12 explicitly marks the "query pauses the SLA clock" convention
  /// as TBV rather than universally true — see architecture analysis §4
  /// item #3.
  slaPauseOnQuery Boolean           @default(false) @map("sla_pause_on_query")

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  applicationStages ApplicationStage[]
  dependents        WorkflowStageDependency[] @relation("WorkflowStageDependencyStage")
  dependencies      WorkflowStageDependency[] @relation("WorkflowStageDependencyDependsOnStage")

  @@index([workflowId])
  @@map("workflow_stages")
}

/// Self-referencing join expressing "this stage cannot start until that
/// stage completes" — AND-only joins (a stage with multiple dependency rows
/// requires all of them), per the architecture analysis §13. Pure glue, no
/// independent meaning, cascades with either side.
model WorkflowStageDependency {
  workflowStageId          String @map("workflow_stage_id") @db.Uuid
  dependsOnWorkflowStageId String @map("depends_on_workflow_stage_id") @db.Uuid

  workflowStage          WorkflowStage @relation("WorkflowStageDependencyStage", fields: [workflowStageId], references: [id], onDelete: Cascade)
  dependsOnWorkflowStage WorkflowStage @relation("WorkflowStageDependencyDependsOnStage", fields: [dependsOnWorkflowStageId], references: [id], onDelete: Cascade)

  @@id([workflowStageId, dependsOnWorkflowStageId])
  @@map("workflow_stage_dependencies")
}

model OfficerDelegation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromOfficerId String   @map("from_officer_id") @db.Uuid
  toOfficerId   String   @map("to_officer_id") @db.Uuid
  departmentId  String   @map("department_id") @db.Uuid
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  reason        String
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  fromOfficer User       @relation("OfficerDelegationFrom", fields: [fromOfficerId], references: [id], onDelete: Restrict)
  toOfficer   User       @relation("OfficerDelegationTo", fields: [toOfficerId], references: [id], onDelete: Restrict)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  creator     User       @relation("OfficerDelegationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("officer_delegations")
}

// ============================================================================
// INSPECTION
// ============================================================================

enum InspectionStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("inspection_status")
}

/// An inspection of an application's site (FRD 24; TRD 10, 23 "FK -> Application,
/// -> Officer (inspector)"; Blueprint 12.5). Step 11A holds only the
/// foundation: the application it belongs to, the inspector, the schedule and
/// the site. Enterprise, project and department are reached THROUGH the
/// application (project -> enterprise; approval type -> department), never
/// copied here. Reports, findings and completion are Step 11B; nothing in this
/// step writes COMPLETED or CANCELLED.
///
/// Status is DERIVED, never client-supplied: PENDING (assigned, not yet
/// scheduled) or SCHEDULED (has a date/time) - a check constraint keeps the two
/// coherent. application_stage_id stays NULL until the workflow engine
/// instantiates stages (a later step); the direct application_id is the
/// authoritative link.
model Inspection {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String           @map("application_id") @db.Uuid
  applicationStageId String?          @map("application_stage_id") @db.Uuid
  inspectorId        String           @map("inspector_id") @db.Uuid
  scheduledAt        DateTime?        @map("scheduled_at")
  status             InspectionStatus @default(PENDING)
  siteAddress        String           @map("site_address")
  /// TRD �10.1 flags geo-tagging as legally/consent-sensitive and TBV -
  /// defaults to false; geo capture is never assumed permitted.
  geoConsentGiven    Boolean          @default(false) @map("geo_consent_given")
  /// Who created the inspection, and who most recently (re)assigned the
  /// inspector and when (assignment metadata). Every change is also an audit
  /// event; these columns are the current state.
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  assignedByUserId   String           @map("assigned_by_user_id") @db.Uuid
  assignedAt         DateTime         @default(now()) @map("assigned_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  /// The assigned inspector's confirmation of the scheduled visit (FRD 4.4
  /// "confirm/reschedule a visit"). Recorded as DATA, not a status: the
  /// requirements define no "confirmed" state. Cleared whenever the schedule
  /// or the inspector changes (a database rule), so a confirmation always
  /// refers to the current date and inspector.
  confirmedAt        DateTime?        @map("confirmed_at")
  confirmedByUserId  String?          @map("confirmed_by_user_id") @db.Uuid

  application      ApprovalApplication      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  applicationStage ApplicationStage?        @relation(fields: [applicationStageId], references: [id], onDelete: Restrict)
  inspector        User                     @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  createdBy        User                     @relation("InspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedBy       User                     @relation("InspectionAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  confirmedBy      User?                    @relation("InspectionConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  /// Checklist results / findings (append-only; see InspectionReport).
  reports          InspectionReport[]
  evidence         InspectionEvidence[]
  reportSummary    InspectionReportSummary?

  @@index([inspectorId, status])
  @@index([scheduledAt])
  @@index([applicationId, createdAt])
  @@map("inspections")
}

model InspectionChecklist {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId String @map("approval_type_id") @db.Uuid
  itemText       String @map("item_text")
  sequenceOrder  Int    @map("sequence_order")

  approvalType ApprovalType       @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  reports      InspectionReport[]

  @@index([approvalTypeId])
  @@map("inspection_checklists")
}

enum InspectionFinding {
  COMPLIANT
  NON_COMPLIANT
  CONDITIONAL

  @@map("inspection_finding")
}

/// One recorded RESULT for one checklist item of one inspection (Blueprint 12.5
/// `inspection_reports`: response + finding + notes + optional evidence).
/// APPEND-ONLY: a result is never edited; correcting one records a new row and
/// the latest row per item is the current one, so the earlier answer stays on
/// the record (a database trigger rejects every UPDATE). The item's text is
/// copied at the time, so a later change to the checklist cannot rewrite what
/// the inspector actually answered. Rows can be added only while the
/// inspection is SCHEDULED, only by its inspector, only for an item of the
/// application's own approval type, and only with evidence of this inspection.
model InspectionReport {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId       String            @map("inspection_id") @db.Uuid
  checklistItemId    String            @map("checklist_item_id") @db.Uuid
  /// The checklist item's wording when it was answered.
  itemText           String            @map("item_text")
  response           String
  /// A document that is evidence OF THIS INSPECTION (inspection_evidence).
  evidenceDocumentId String?           @map("evidence_document_id") @db.Uuid
  finding            InspectionFinding
  notes              String?
  recordedByUserId   String            @map("recorded_by_user_id") @db.Uuid
  recordedAt         DateTime          @default(now()) @map("recorded_at")

  inspection       Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  checklistItem    InspectionChecklist @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  evidenceDocument Document?           @relation(fields: [evidenceDocumentId], references: [id], onDelete: Restrict)
  recordedBy       User                @relation("InspectionResultRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([inspectionId, checklistItemId, recordedAt])
  @@map("inspection_reports")
}

/// Evidence (photos / documents) an inspector attached to an inspection (FRD
/// 24.2 "evidence upload ... with metadata such as capture time"; TRD 10.1).
/// The FILE is an ordinary Step 9 document (same storage, same malware scan);
/// this row is the inspection -> evidence -> document(version) relationship.
/// Only the capture time the inspector declares is kept: geo-tagging is
/// legally / consent sensitive and TO BE VALIDATED (TRD 10.1), so no location
/// is ever captured. Append-only; a document can be evidence of one
/// inspection only, and only if it is scanned and usable (database trigger).
model InspectionEvidence {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId     String    @map("inspection_id") @db.Uuid
  documentId       String    @unique @map("document_id") @db.Uuid
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  /// When the inspector says the photo / document was captured (optional).
  capturedAt       DateTime? @map("captured_at")
  caption          String?
  createdAt        DateTime  @default(now()) @map("created_at")

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy User       @relation("InspectionEvidenceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([inspectionId, createdAt])
  @@map("inspection_evidence")
}

/// The submitted inspection report (FRD 24.2 "findings summary (compliant /
/// non-compliant / conditional)", "corrective-action recommendation field where
/// findings are non-compliant", "Submit Report"). One per inspection, immutable
/// once written; writing it is what completes the inspection (the same
/// transaction moves SCHEDULED -> COMPLETED, and the database refuses COMPLETED
/// without it). TRD 10.1 also names a "re-inspection required" outcome that
/// "feeds the application state machine": no such outcome or transition is
/// invented here - it is TO BE VALIDATED.
model InspectionReportSummary {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId      String            @unique @map("inspection_id") @db.Uuid
  overallFinding    InspectionFinding @map("overall_finding")
  /// The inspector's observations.
  summary           String
  /// Required when the overall finding is NON_COMPLIANT.
  correctiveAction  String?           @map("corrective_action")
  submittedByUserId String            @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime          @default(now()) @map("submitted_at")

  inspection  Inspection @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  submittedBy User       @relation("InspectionReportSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@map("inspection_report_summaries")
}

enum InspectorConflictStatus {
  DECLARED
  CLEARED
  CONFIRMED

  @@map("inspector_conflict_status")
}

model InspectorConflict {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectorId String                  @map("inspector_id") @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  declaredAt  DateTime                @default(now()) @map("declared_at")
  reviewedBy  String?                 @map("reviewed_by") @db.Uuid
  status      InspectorConflictStatus @default(DECLARED)

  inspector User    @relation("InspectorConflictInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  reviewer  User?   @relation("InspectorConflictReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("inspector_conflicts")
}

// ============================================================================
// COMPLIANCE AND RENEWAL
// ============================================================================

enum ComplianceFrequency {
  ONE_TIME
  MONTHLY
  ANNUAL

  @@map("compliance_frequency")
}

/// An obligation a DEPARTMENT has explicitly configured against an approval
/// type (FRD 27.2; TRD 14). Nothing is seeded and nothing is inferred: an
/// approval with no requirement simply has no obligations. Edited in place; each
/// edit bumps `version`, and every record keeps a snapshot of the version it was
/// created under, so history is never re-written.
model ComplianceRequirement {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId    String              @map("approval_type_id") @db.Uuid
  /// Plain-language requirement (FRD 27.1).
  description       String
  frequency         ComplianceFrequency
  /// The source of the obligation (e.g. the clause it derives from). Free text
  /// the department supplies; never invented by the platform.
  sourceReference   String?             @map("source_reference")
  /// FRD 27.1 "supporting document (if any is required to evidence fulfilment)".
  evidenceRequired  Boolean             @default(false) @map("evidence_required")
  /// FRD 27.1 "the action the applicant must take".
  applicantAction   String?             @map("applicant_action")
  /// Calendar days from the start of the compliance period to the FIRST due
  /// date. NULL = "not yet configured": the requirements define no such
  /// duration, so none is shipped or defaulted (FRD 27.2 / 25.3 spirit).
  firstDueAfterDays Int?                @map("first_due_after_days")
  /// A record is DUE from this many days before its due date (0 = only on the
  /// due date itself). Configuration; the requirements define no window.
  dueWindowDays     Int                 @default(0) @map("due_window_days")
  version           Int                 @default(1)
  /// false stops new occurrences; existing records are kept.
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  approvalType ApprovalType       @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  records      ComplianceRecord[]

  @@index([approvalTypeId])
  @@map("compliance_requirements")
}

enum ComplianceRecordStatus {
  UPCOMING
  DUE
  OVERDUE
  FULFILLED

  @@map("compliance_record_status")
}

/// One OCCURRENCE of an obligation for one application (a recurring obligation
/// has one row per occurrence; none is ever overwritten). The requirement is
/// SNAPSHOTTED here so later configuration changes never re-time or re-word an
/// existing record. Status moves only forward, through the platform's own
/// actions (database trigger); FULFILLED is permanent.
model ComplianceRecord {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId           String                 @map("application_id") @db.Uuid
  complianceRequirementId String                 @map("compliance_requirement_id") @db.Uuid
  /// 1, 2, 3... per application and requirement.
  occurrenceNumber        Int                    @default(1) @map("occurrence_number")
  /// A calendar date; NULL while the department has not configured a first due
  /// date ("Due date not yet configured").
  dueDate                 DateTime?              @map("due_date") @db.Date
  status                  ComplianceRecordStatus @default(UPCOMING)
  requirementVersion      Int                    @map("requirement_version")
  description             String
  frequency               ComplianceFrequency
  evidenceRequired        Boolean                @map("evidence_required")
  applicantAction         String?                @map("applicant_action")
  sourceReference         String?                @map("source_reference")
  dueWindowDays           Int                    @map("due_window_days")
  fulfilledAt             DateTime?              @map("fulfilled_at")
  fulfilledByUserId       String?                @map("fulfilled_by_user_id") @db.Uuid
  fulfilledDocumentId     String?                @map("fulfilled_document_id") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at")

  application           ApprovalApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  complianceRequirement ComplianceRequirement @relation(fields: [complianceRequirementId], references: [id], onDelete: Restrict)
  fulfilledDocument     Document?             @relation(fields: [fulfilledDocumentId], references: [id], onDelete: SetNull)
  fulfilledBy           User?                 @relation("ComplianceFulfilledBy", fields: [fulfilledByUserId], references: [id], onDelete: Restrict)

  @@unique([applicationId, complianceRequirementId, occurrenceNumber])
  @@index([applicationId])
  @@index([complianceRequirementId])
  @@index([status, dueDate])
  @@map("compliance_records")
}

model Renewal {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalApplicationId String   @map("original_application_id") @db.Uuid
  newApplicationId      String?  @map("new_application_id") @db.Uuid
  renewalDueDate        DateTime @map("renewal_due_date")
  status                String
  /// Configurable reminder cadence (e.g. days-before-expiry) — deliberately
  /// not hard-coded to 90/60/30/7 per FRD §37 #9 (exact cadence is TBV).
  reminderSchedule      Json     @map("reminder_schedule") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at")

  originalApplication ApprovalApplication  @relation("RenewalOriginalApplication", fields: [originalApplicationId], references: [id], onDelete: Restrict)
  newApplication      ApprovalApplication? @relation("RenewalNewApplication", fields: [newApplicationId], references: [id], onDelete: Restrict)

  @@map("renewals")
}

// ============================================================================
// SCHEMES
// ============================================================================

enum SchemePublishStatus {
  DRAFT
  PUBLISHED

  @@map("scheme_publish_status")
}

/// TRD 15 "status through Applied -> Under Review -> Approved/Rejected ->
/// Disbursed". Exactly the documented set: no draft, query or withdrawn state is
/// defined for a scheme application, so none is modelled.
enum SchemeApplicationStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED

  @@map("scheme_application_status")
}

/// A catalogue entry (FRD 29.2 / Blueprint 12.7). Maintained as a DRAFT by the
/// Scheme Officer and exposed to applicants only once PUBLISHED and active
/// (FRD 34: "subject to a publish/approval step"). Its content, rules and
/// document requirements are frozen while published (database trigger); a
/// revision goes back to DRAFT first. Nothing is ever seeded.
model Scheme {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  departmentId              String              @map("department_id") @db.Uuid
  description               String
  benefits                  String
  isActive                  Boolean             @default(true) @map("is_active")
  publishStatus             SchemePublishStatus @default(DRAFT) @map("publish_status")
  /// FRD 29.2 "eligibility criteria (plain language)". The rules below decide
  /// the recommendation; this is what the applicant reads.
  eligibilityCriteria       String              @default("") @map("eligibility_criteria")
  /// FRD 29.1 "filter by ... benefit type". Free text the department chooses:
  /// the requirements define no benefit-type vocabulary.
  benefitType               String?             @map("benefit_type")
  /// FRD 29.1 / 29.2 "applicable sectors / locations / enterprise size". Browse
  /// and filter facets the department maintains; an empty list means the
  /// department has not restricted the scheme on that facet. Display only: they
  /// never take part in the eligibility recommendation (the rules do).
  applicableSectors         String[]            @default([]) @map("applicable_sectors")
  applicableDistricts       String[]            @default([]) @map("applicable_districts")
  applicableEnterpriseSizes String[]            @default([]) @map("applicable_enterprise_sizes")
  /// FRD 29.2 "application deadline (if any)". NULL = none configured.
  applicationDeadline       DateTime?           @map("application_deadline")
  /// Where the scheme comes from (TRD 15 catalogue sourcing), as the
  /// department cites it. NULL = not supplied; never guessed.
  sourceReference           String?             @map("source_reference")
  version                   Int                 @default(1)
  createdByUserId           String              @map("created_by_user_id") @db.Uuid
  publishedAt               DateTime?           @map("published_at")
  publishedByUserId         String?             @map("published_by_user_id") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  department           Department                  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("SchemeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy          User?                       @relation("SchemePublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  rules                SchemeRule[]
  documentRequirements SchemeDocumentRequirement[]
  applications         SchemeApplication[]

  @@index([departmentId])
  @@index([publishStatus, isActive])
  @@map("schemes")
}

/// An eligibility rule VERSION (TRD 15: "the same pattern as approval rules").
/// Immutable once written (database trigger); the version applied at a moment
/// is the highest effective one, so history is never rewritten.
model SchemeRule {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId        String    @map("scheme_id") @db.Uuid
  version         Int
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  isActive        Boolean   @default(true) @map("is_active")
  conditions      Json      @db.JsonB
  /// Ranking only (lower = listed first); the requirements define no ranking
  /// criterion, so this is the department's own ordering, defaulting to 100.
  priority        Int       @default(100)
  /// Evidence for the rule; the literal "TBD" where the department has not
  /// supplied one.
  sourceReference String    @map("source_reference")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  scheme    Scheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  createdBy User   @relation("SchemeRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([schemeId, version])
  @@index([schemeId])
  @@map("scheme_rules")
}

/// FRD 29.2 "required documents" for a scheme. Same shape as a document
/// requirement of an approval (limits included), so the one upload pipeline
/// applies its limits unchanged. Configured by the department; none are seeded.
model SchemeDocumentRequirement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId         String   @map("scheme_id") @db.Uuid
  name             String
  isMandatory      Boolean  @map("is_mandatory")
  description      String?
  maxSizeBytes     Int?     @map("max_size_bytes")
  allowedMimeTypes String[] @default([]) @map("allowed_mime_types")

  scheme    Scheme                      @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  documents SchemeApplicationDocument[]

  @@index([schemeId])
  @@map("scheme_document_requirements")
}

/// An applicant's request for a scheme (TRD 15 "Application & benefit
/// tracking", FRD 29.5). `status` moves only along the documented transitions
/// (database trigger); every change is also written to the history table.
model SchemeApplication {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId          String                  @map("scheme_id") @db.Uuid
  projectId         String                  @map("project_id") @db.Uuid
  /// Blueprint 8.2 routes a scheme application through "a Scheme-type workflow
  /// definition". Workflows are keyed to approval types and no scheme-type
  /// workflow is defined by the requirements, so this stays NULL (TBV).
  workflowId        String?                 @map("workflow_id") @db.Uuid
  status            SchemeApplicationStatus @default(APPLIED)
  submittedAt       DateTime?               @map("submitted_at")
  decidedAt         DateTime?               @map("decided_at")
  referenceNumber   String?                 @unique @default(dbgenerated("((('SCH-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('scheme_application_reference_seq'::regclass))::text, 6, '0'::text))")) @map("reference_number")
  /// FRD 34 "record final decisions with a reason".
  decisionReason    String?                 @map("decision_reason")
  decidedByUserId   String?                 @map("decided_by_user_id") @db.Uuid
  /// When the Scheme Officer recorded the benefit as disbursed. A status marker
  /// only: no amount, payment or bank detail is modelled.
  disbursedAt       DateTime?               @map("disbursed_at")
  /// What the applicant applied on: the catalogue entry as it read, and the
  /// system's recommendation for the project at that moment (or that there was
  /// none). Recommendation only, never a determination.
  catalogueSnapshot Json                    @map("catalogue_snapshot") @db.JsonB
  createdByUserId   String                  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  scheme    Scheme                           @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  project   Project                          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workflow  Workflow?                        @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  createdBy User                             @relation("SchemeApplicationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decidedBy User?                            @relation("SchemeApplicationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  history   SchemeApplicationStatusHistory[]
  documents SchemeApplicationDocument[]

  @@index([schemeId, status])
  @@index([projectId])
  @@map("scheme_applications")
}

/// TRD 23.2: "an explicit enum status column plus a full history table".
/// Append-only (database trigger).
model SchemeApplicationStatusHistory {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeApplicationId String                   @map("scheme_application_id") @db.Uuid
  fromStatus          SchemeApplicationStatus? @map("from_status")
  toStatus            SchemeApplicationStatus  @map("to_status")
  actorUserId         String                   @map("actor_user_id") @db.Uuid
  actorRole           String                   @map("actor_role")
  reason              String?
  createdAt           DateTime                 @default(now()) @map("created_at")

  schemeApplication SchemeApplication @relation(fields: [schemeApplicationId], references: [id], onDelete: Restrict)
  actor             User              @relation("SchemeStatusChangedBy", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([schemeApplicationId, createdAt])
  @@map("scheme_application_status_history")
}

/// Supporting evidence of a scheme application: an ordinary document (the one
/// upload pipeline: validated, malware-scanned, stored under a server-generated
/// key, versioned) plus this link to the application and, optionally, the
/// scheme's document requirement it answers. Created once, never re-pointed.
model SchemeApplicationDocument {
  schemeApplicationId         String  @map("scheme_application_id") @db.Uuid
  documentId                  String  @map("document_id") @db.Uuid
  schemeDocumentRequirementId String? @map("scheme_document_requirement_id") @db.Uuid

  schemeApplication         SchemeApplication          @relation(fields: [schemeApplicationId], references: [id], onDelete: Cascade)
  document                  Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  schemeDocumentRequirement SchemeDocumentRequirement? @relation(fields: [schemeDocumentRequirementId], references: [id], onDelete: Restrict)

  @@id([schemeApplicationId, documentId])
  @@index([schemeApplicationId])
  @@index([documentId])
  @@index([schemeDocumentRequirementId])
  @@map("scheme_application_documents")
}

// ============================================================================
// GRIEVANCES
// ============================================================================

enum GrievanceStatus {
  OPEN
  ASSIGNED
  RESOLVED
  ESCALATED
  CLOSED
  REOPENED

  @@map("grievance_status")
}

model Grievance {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raisedByUserId       String          @map("raised_by_user_id") @db.Uuid
  applicationId        String?         @map("application_id") @db.Uuid
  category             String
  description          String
  status               GrievanceStatus @default(OPEN)
  assignedDepartmentId String          @map("assigned_department_id") @db.Uuid
  assignedOfficerId    String?         @map("assigned_officer_id") @db.Uuid
  slaDueAt             DateTime?       @map("sla_due_at")
  reopenDeadline       DateTime?       @map("reopen_deadline")
  createdAt            DateTime        @default(now()) @map("created_at")
  resolvedAt           DateTime?       @map("resolved_at")

  raisedBy           User                 @relation("GrievanceRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  application        ApprovalApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  assignedDepartment Department           @relation(fields: [assignedDepartmentId], references: [id], onDelete: Restrict)
  assignedOfficer    User?                @relation("GrievanceAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: Restrict)
  updates            GrievanceUpdate[]

  @@index([assignedDepartmentId])
  @@index([assignedOfficerId])
  @@map("grievances")
}

enum GrievanceUpdateType {
  COMMENT
  STATUS_CHANGE
  ESCALATION

  @@map("grievance_update_type")
}

model GrievanceUpdate {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grievanceId String              @map("grievance_id") @db.Uuid
  actorUserId String              @map("actor_user_id") @db.Uuid
  updateType  GrievanceUpdateType @map("update_type")
  message     String
  createdAt   DateTime            @default(now()) @map("created_at")

  grievance Grievance @relation(fields: [grievanceId], references: [id], onDelete: Restrict)
  actor     User      @relation("GrievanceUpdateActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([grievanceId])
  @@map("grievance_updates")
}

