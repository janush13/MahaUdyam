// ============================================================================
// MahaUdyam One — Database Schema
// Step 2: Database Foundation (schema/migration infrastructure only).
//
// No business logic, seed statutory data, or query code depends on this
// schema yet — see backend/README.md and the Step 2 execution report for
// what is and is not implemented.
//
// Naming convention: Prisma model names are PascalCase; every model maps to
// a snake_case table via @@map, and every field maps to a snake_case column
// via @map, so the database itself is 100% snake_case regardless of the
// camelCase used in application code.
//
// IDs: UUID, generated by PostgreSQL (`gen_random_uuid()`, built into core
// since PG13) rather than client-side, so rows inserted by any tool (Prisma,
// raw SQL, a future admin script) get a valid id without extra plumbing.
//
// Delete behavior: the default posture in this schema is `Restrict` on any
// relation that touches a record with independent historical/statutory
// significance (per the architecture analysis's "government records should
// not cascade-delete accidentally" rule). `Cascade` is used only for pure
// join/glue rows with no independent meaning of their own (e.g.
// RolePermission, ApplicationDocument, the two self-referencing dependency
// join tables, MfaCredential, Notification). `SetNull` is used only where
// nulling an optional FK preserves the owning row's own meaning without the
// link (e.g. AuditLog.userId, Document.documentRequirementId).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` from the datasource block — the connection string
// now lives in prisma.config.ts (for Migrate/introspection) and is passed
// to PrismaClient via a driver adapter at runtime (see
// src/infrastructure/prisma/prisma.service.ts). DATABASE_URL still comes
// from the environment either way; no credential is hard-coded anywhere.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// IDENTITY AND ACCESS
// ============================================================================

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  email               String    @unique
  mobile              String    @unique
  /// Nullable because the authentication standard (password vs. OTP-only
  /// passwordless) remains configurable/TBV per FRD §9.2 — do not assume a
  /// value is always present.
  passwordHash        String?   @map("password_hash")
  isVerified          Boolean   @default(false) @map("is_verified")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  /// Step 4 addition — supports the ACCOUNT_DISABLED error code (FRD §4.9's
  /// "deactivation" capability). No deactivation endpoint exists yet (that's
  /// admin-module territory); the field/check exists so login can honour it
  /// once one does.
  isActive            Boolean   @default(true) @map("is_active")
  /// Step 4 addition — account-lockout support (Blueprint §13.1:
  /// AUTH_ACCOUNT_LOCKED "after a configurable failed-attempt threshold").
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  userRoles                   UserRole[]
  mfaCredential               MfaCredential?
  refreshSessions             RefreshSession[]
  enterprisesOwned            Enterprise[]               @relation("EnterpriseOwner")
  enterpriseRepresentations   EnterpriseRepresentative[] @relation("EnterpriseRepresentativeUser")
  approvalRulesCreated        ApprovalRule[]             @relation("ApprovalRuleCreatedBy")
  documentsUploaded           Document[]                 @relation("DocumentUploadedBy")
  documentVerifications       DocumentVerification[]     @relation("DocumentVerifiedBy")
  applicationStagesAssigned   ApplicationStage[]         @relation("ApplicationStageAssignedOfficer")
  applicationTasksCreated     ApplicationTask[]          @relation("ApplicationTaskCreatedBy")
  delegationsFrom             OfficerDelegation[]        @relation("OfficerDelegationFrom")
  delegationsTo               OfficerDelegation[]        @relation("OfficerDelegationTo")
  delegationsCreated          OfficerDelegation[]        @relation("OfficerDelegationCreatedBy")
  inspectionsConducted        Inspection[]               @relation("InspectionInspector")
  inspectorConflictsDeclared  InspectorConflict[]        @relation("InspectorConflictInspector")
  inspectorConflictsReviewed  InspectorConflict[]        @relation("InspectorConflictReviewedBy")
  grievancesRaised            Grievance[]                @relation("GrievanceRaisedBy")
  grievancesAssigned          Grievance[]                @relation("GrievanceAssignedOfficer")
  grievanceUpdatesAuthored    GrievanceUpdate[]          @relation("GrievanceUpdateActor")
  regulatoryDocumentsUploaded RegulatoryDocument[]       @relation("RegulatoryDocumentUploadedBy")
  notifications               Notification[]
  auditLogs                   AuditLog[]

  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  description String?

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Join table — pure relational glue between Role and Permission, no
/// independent meaning, so both FKs cascade.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  roleId       String  @map("role_id") @db.Uuid
  /// Nullable — not every role is department-scoped (e.g. Applicant, Super
  /// Admin, Auditor).
  departmentId String? @map("department_id") @db.Uuid

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@map("user_roles")
}

/// TOTP MFA credential. 1:1 with User — keyed directly by userId.
/// totpSecret stores CIPHERTEXT (AES-256-GCM, see src/modules/auth), never
/// the raw secret — the column name is inherited from Step 2 but its
/// content changed in Step 4; never log or return this field.
/// enabledAt is NULL while enrollment is pending confirmation (a row can
/// exist — secret generated — before MFA is actually active) and is set
/// only once POST /auth/mfa/confirm succeeds; `users.mfa_enabled` is the
/// authoritative "is MFA currently active" flag, flipped at the same time.
model MfaCredential {
  userId     String    @id @map("user_id") @db.Uuid
  totpSecret String    @map("totp_secret")
  enabledAt  DateTime? @map("enabled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_credentials")
}

/// Server-side refresh-token session, enabling rotation and reuse
/// detection that a pure stateless JWT cannot provide on its own. The
/// refresh token issued to the client IS a signed JWT (uses the existing
/// JWT_REFRESH_SECRET/JWT_REFRESH_EXPIRES_IN config), but the raw token is
/// never stored — only a SHA-256 hash of it, used purely for lookup.
/// familyId groups an entire rotation chain: on detected reuse (a
/// tokenHash whose row is already revoked being presented again), the
/// whole family is revoked, not just the one row, since reuse implies the
/// token may have been stolen at any point in the chain.
model RefreshSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  issuedAt     DateTime  @default(now()) @map("issued_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

// ============================================================================
// DEPARTMENTS
// ----------------------------------------------------------------------------
// Not explicitly listed as its own table in the Step 2 field-by-field spec,
// but required for referential integrity: approval_types.department_id,
// workflow_stages.department_id, user_roles.department_id,
// grievances.assigned_department_id, schemes.department_id, and
// officer_delegations.department_id all reference a department, and the
// architecture analysis (and TRD §2/§23.1) both treat "Department" as its
// own entity. Kept intentionally minimal — no statutory department data is
// seeded here (see the seed script and report for why).
// ============================================================================

model Department {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  code     String  @unique
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  approvalTypes      ApprovalType[]
  workflowStages     WorkflowStage[]
  userRoles          UserRole[]
  grievances         Grievance[]
  schemes            Scheme[]
  officerDelegations OfficerDelegation[]

  @@map("departments")
}

// ============================================================================
// ENTERPRISE AND PROJECT
// ============================================================================

model Enterprise {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  businessType           String   @map("business_type")
  registrationNumber     String   @map("registration_number")
  /// Kept as free text (not an enum) — the exact registration format
  /// (Udyam/CIN/other) is TBV per FRD §37 #2; hard-coding a fixed set here
  /// would silently commit to an unconfirmed government standard.
  registrationNumberType String   @map("registration_number_type")
  address                String
  ownerUserId            String   @map("owner_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  owner           User                       @relation("EnterpriseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  representatives EnterpriseRepresentative[]
  projects        Project[]

  @@index([ownerUserId])
  @@map("enterprises")
}

enum RepresentativeScope {
  VIEW_ONLY
  PREPARE_SUBMIT
  FULL

  @@map("representative_scope")
}

enum RepresentativeStatus {
  PENDING
  ACTIVE
  REVOKED

  @@map("representative_status")
}

model EnterpriseRepresentative {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId         String               @map("enterprise_id") @db.Uuid
  representativeUserId String               @map("representative_user_id") @db.Uuid
  scope                RepresentativeScope
  /// Empty array = unrestricted (applies to every project under the
  /// enterprise); a non-empty array restricts the delegation to specific
  /// projects, per FRD §20.3's per-project granularity.
  scopedProjectIds     String[]             @default([]) @map("scoped_project_ids") @db.Uuid
  status               RepresentativeStatus @default(PENDING)
  authorisedAt         DateTime?            @map("authorised_at")
  expiresAt            DateTime?            @map("expires_at")
  revokedAt            DateTime?            @map("revoked_at")

  enterprise     Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  representative User       @relation("EnterpriseRepresentativeUser", fields: [representativeUserId], references: [id], onDelete: Restrict)

  @@index([enterpriseId])
  @@index([representativeUserId])
  @@map("enterprise_representatives")
}

model Project {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enterpriseId          String   @map("enterprise_id") @db.Uuid
  name                  String
  district              String
  taluka                String
  industrialArea        String?  @map("industrial_area")
  sectorCode            String   @map("sector_code")
  enterpriseSizeBand    String   @map("enterprise_size_band")
  investmentAmount      Decimal  @map("investment_amount") @db.Decimal(16, 2)
  employmentCount       Int      @map("employment_count")
  landStatus            String   @map("land_status")
  /// Conditional sub-object (e.g. lease term/lessor details) that only
  /// applies when landStatus = "Leased" — genuinely variable shape per FRD
  /// §9.2, hence JSONB rather than fixed columns.
  landLeaseDetails      Json?    @map("land_lease_details") @db.JsonB
  constructionStatus    String   @map("construction_status")
  productionStatus      String   @map("production_status")
  environmentalCategory String?  @map("environmental_category")
  hazardousFlag         Boolean  @map("hazardous_flag")
  hazardousCategory     String?  @map("hazardous_category")
  projectStage          String   @map("project_stage")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  enterprise         Enterprise            @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  applications       ApprovalApplication[]
  discoverySnapshots DiscoverySnapshot[]
  inspectorConflicts InspectorConflict[]
  schemeApplications SchemeApplication[]

  @@index([enterpriseId])
  @@map("projects")
}

// ============================================================================
// APPROVAL DISCOVERY
// ============================================================================

model ApprovalType {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  legalName      String? @map("legal_name")
  departmentId   String  @map("department_id") @db.Uuid
  description    String?
  legalReference String? @map("legal_reference")
  isActive       Boolean @default(true) @map("is_active")

  department             Department              @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rules                  ApprovalRule[]
  documentRequirements   DocumentRequirement[]
  workflows              Workflow[]
  applications           ApprovalApplication[]
  inspectionChecklists   InspectionChecklist[]
  complianceRequirements ComplianceRequirement[]
  regulatoryDocuments    RegulatoryDocument[]
  dependents             ApprovalDependency[]    @relation("ApprovalDependencyApprovalType")
  dependencies           ApprovalDependency[]    @relation("ApprovalDependencyDependsOnApprovalType")

  @@index([departmentId])
  @@map("approval_types")
}

model ApprovalRule {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId       String    @map("approval_type_id") @db.Uuid
  version              Int
  effectiveFrom        DateTime  @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")
  isActive             Boolean   @default(true) @map("is_active")
  /// Real database field, not a frontend-only distinction: true =
  /// "Officially Required" (department has explicitly confirmed the rule as
  /// authoritative); false (default) = "Potentially Applicable" only.
  /// See FRD §10.3 — this must never be inferred client-side.
  isOfficiallyRequired Boolean   @default(false) @map("is_officially_required")
  /// Rule condition grammar (equals/in/not_in/gt/lt/between, combined via
  /// all/any) — see the architecture analysis §12. Evaluated by the (later)
  /// discovery engine, not by this schema.
  conditions           Json      @db.JsonB
  excludesIf           Json?     @map("excludes_if") @db.JsonB
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")

  approvalType ApprovalType @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  creator      User         @relation("ApprovalRuleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([approvalTypeId])
  @@index([effectiveFrom])
  @@index([effectiveTo])
  @@map("approval_rules")
}

/// Self-referencing many-to-many on ApprovalType, expressing "this approval
/// depends on that approval" (e.g. a Fire NOC that requires Consent to
/// Establish first) — a relationship between approvals, not a rule
/// condition, per the architecture analysis §12.
model ApprovalDependency {
  approvalTypeId          String @map("approval_type_id") @db.Uuid
  dependsOnApprovalTypeId String @map("depends_on_approval_type_id") @db.Uuid

  approvalType          ApprovalType @relation("ApprovalDependencyApprovalType", fields: [approvalTypeId], references: [id], onDelete: Cascade)
  dependsOnApprovalType ApprovalType @relation("ApprovalDependencyDependsOnApprovalType", fields: [dependsOnApprovalTypeId], references: [id], onDelete: Cascade)

  @@id([approvalTypeId, dependsOnApprovalTypeId])
  @@map("approval_dependencies")
}

/// Persists exactly which rule versions fired for a project's discovery run,
/// so a historical application can always be reproduced against the rules
/// that were actually in effect at the time — required for statutory
/// defensibility (TRD §4.3) and NOT satisfiable by re-running today's rules.
model DiscoverySnapshot {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  evaluatedAt            DateTime @default(now()) @map("evaluated_at")
  ruleVersionsUsed       Json     @map("rule_versions_used") @db.JsonB
  matchedApprovalTypeIds String[] @default([]) @map("matched_approval_type_ids") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@map("discovery_snapshots")
}

// ============================================================================
// APPLICATIONS — two-layer status model (do not merge these enums; see the
// architecture analysis §3 item #2 and §13 for why this distinction is
// mandatory: internalState is the engine-owned TRD lifecycle, applicantStatus
// is the FRD-facing vocabulary shown to the applicant, and collapsing them
// loses the "scrutiny recommends, only the Approving Authority decides"
// boundary).
// ============================================================================

/// Engine-owned technical lifecycle (TRD §3.2).
///
/// NOTE ON VALIDATION AGAINST SOURCE DOCUMENTS: the Step 2 task brief's
/// suggested state list omitted REJECTED. TRD §3.2 explicitly includes it
/// ("RECOMMENDED_FOR_APPROVAL → APPROVED ... / REJECTED → (WITHDRAWN |
/// RESUBMITTED as new version)") and the rejection→resubmission workflow
/// (FRD §17.3, TRD §3.3) is unusable without it, so it has been added back
/// in. See the Step 2 report, "Architecture Deviations", for the full
/// justification.
enum InternalApplicationState {
  DRAFT
  SUBMITTED
  UNDER_SCRUTINY
  QUERY_RAISED
  APPLICANT_RESPONDED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
  RECOMMENDED_FOR_APPROVAL
  APPROVED
  REJECTED
  CERTIFICATE_ISSUED
  ACTIVE
  RENEWAL_DUE
  RENEWAL_SUBMITTED
  EXPIRED
  WITHDRAWN_BY_APPLICANT
  CANCELLED
  DUPLICATE_FLAGGED

  @@map("internal_application_state")
}

/// Applicant-facing vocabulary (FRD §11.2). NOT_STARTED is deliberately
/// excluded: it describes a checklist item for which no application row
/// exists yet (handled by the future ChecklistModule), so it can never be
/// the value of an actual approval_applications row, which only exists once
/// an application has at least reached Draft.
enum ApplicantStatus {
  DRAFT
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_SCRUTINY
  QUERY_RAISED
  AWAITING_APPLICANT
  INSPECTION_PENDING
  INSPECTION_SCHEDULED
  AWAITING_DECISION
  APPROVED
  REJECTED
  WITHDRAWN
  CLOSED
  RENEWAL_DUE

  @@map("applicant_status")
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH

  @@map("risk_band")
}

model ApprovalApplication {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId             String                   @map("project_id") @db.Uuid
  approvalTypeId        String                   @map("approval_type_id") @db.Uuid
  workflowId            String                   @map("workflow_id") @db.Uuid
  internalState         InternalApplicationState @default(DRAFT) @map("internal_state")
  applicantStatus       ApplicantStatus          @default(DRAFT) @map("applicant_status")
  previousApplicationId String?                  @map("previous_application_id") @db.Uuid
  referenceNumber       String?                  @unique @map("reference_number")
  submittedAt           DateTime?                @map("submitted_at")
  decidedAt             DateTime?                @map("decided_at")
  decisionReason        String?                  @map("decision_reason")
  riskBand              RiskBand?                @map("risk_band")
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  project             Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approvalType        ApprovalType          @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  workflow            Workflow              @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  previousApplication ApprovalApplication?  @relation("ApplicationResubmission", fields: [previousApplicationId], references: [id], onDelete: Restrict)
  resubmissions       ApprovalApplication[] @relation("ApplicationResubmission")

  stages               ApplicationStage[]
  applicationDocuments ApplicationDocument[]
  complianceRecords    ComplianceRecord[]
  grievances           Grievance[]
  renewalsAsOriginal   Renewal[]             @relation("RenewalOriginalApplication")
  renewalsAsNew        Renewal[]             @relation("RenewalNewApplication")

  @@index([projectId])
  @@index([approvalTypeId])
  @@index([internalState])
  @@index([applicantStatus])
  @@map("approval_applications")
}

enum ApplicationStageStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED

  @@map("application_stage_status")
}

model ApplicationStage {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String                 @map("application_id") @db.Uuid
  workflowStageId   String                 @map("workflow_stage_id") @db.Uuid
  status            ApplicationStageStatus @default(PENDING)
  startedAt         DateTime?              @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  slaDueAt          DateTime?              @map("sla_due_at")
  slaPausedAt       DateTime?              @map("sla_paused_at")
  assignedOfficerId String?                @map("assigned_officer_id") @db.Uuid
  version           Int                    @default(1)

  application     ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  workflowStage   WorkflowStage       @relation(fields: [workflowStageId], references: [id], onDelete: Restrict)
  assignedOfficer User?               @relation("ApplicationStageAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)

  tasks       ApplicationTask[]
  inspections Inspection[]

  @@index([applicationId])
  @@index([assignedOfficerId])
  @@map("application_stages")
}

enum ApplicationTaskType {
  QUERY
  CORRECTION
  REVIEW
  ESCALATION

  @@map("application_task_type")
}

/// No literal task-status vocabulary is specified in FRD/TRD/Blueprint (they
/// describe the query/response cycle functionally, not as named states) —
/// this minimal OPEN/RESOLVED/CANCELLED set is a judgment call to give the
/// column a type instead of a free-text status, kept intentionally small.
enum ApplicationTaskStatus {
  OPEN
  RESOLVED
  CANCELLED

  @@map("application_task_status")
}

model ApplicationTask {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationStageId String                @map("application_stage_id") @db.Uuid
  type               ApplicationTaskType
  /// Query-loop protection (TRD §3.2: "must have a configurable maximum
  /// round count... after which the application auto-escalates"). Business
  /// logic that reads/enforces this is a later step; the column exists now
  /// so it doesn't need to be retrofitted.
  roundNumber        Int                   @default(1) @map("round_number")
  status             ApplicationTaskStatus @default(OPEN)
  createdBy          String                @map("created_by") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  resolvedAt         DateTime?             @map("resolved_at")

  applicationStage ApplicationStage @relation(fields: [applicationStageId], references: [id], onDelete: Restrict)
  creator          User             @relation("ApplicationTaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([applicationStageId])
  @@map("application_tasks")
}

// ============================================================================
// DOCUMENTS — reusable enterprise/project-owned assets, never inherently
// owned by a single application (TRD §6.2's "Submit Once" principle).
// ============================================================================

enum DocumentOwnerType {
  ENTERPRISE
  PROJECT

  @@map("document_owner_type")
}

enum DocumentStatus {
  UPLOADED
  SCAN_PENDING
  VALIDATION_PENDING
  VERIFIED
  REJECTED
  EXPIRED

  @@map("document_status")
}

model Document {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerType             DocumentOwnerType @map("owner_type")
  ownerId               String            @map("owner_id") @db.Uuid
  documentRequirementId String?           @map("document_requirement_id") @db.Uuid
  filePath              String            @map("file_path")
  checksum              String
  originalFilename      String            @map("original_filename")
  mimeType              String            @map("mime_type")
  sizeBytes             Int               @map("size_bytes")
  status                DocumentStatus    @default(UPLOADED)
  expiryDate            DateTime?         @map("expiry_date")
  version               Int               @default(1)
  replacedDocumentId    String?           @map("replaced_document_id") @db.Uuid
  uploadedBy            String            @map("uploaded_by") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  documentRequirement DocumentRequirement? @relation(fields: [documentRequirementId], references: [id], onDelete: SetNull)
  replacedDocument    Document?            @relation("DocumentReplacement", fields: [replacedDocumentId], references: [id], onDelete: Restrict)
  replacements        Document[]           @relation("DocumentReplacement")
  uploader            User                 @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  applicationDocuments ApplicationDocument[]
  verifications        DocumentVerification[]
  complianceRecords    ComplianceRecord[]
  inspectionReports    InspectionReport[]

  @@index([ownerId])
  @@index([checksum])
  @@index([expiryDate])
  @@map("documents")
}

/// Join table — many verified documents can serve many applications
/// (TRD §23.1); pure relational glue, cascades with either side.
model ApplicationDocument {
  applicationId String @map("application_id") @db.Uuid
  documentId    String @map("document_id") @db.Uuid

  application ApprovalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId])
  @@index([applicationId])
  @@index([documentId])
  @@map("application_documents")
}

model DocumentRequirement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId   String   @map("approval_type_id") @db.Uuid
  name             String
  isMandatory      Boolean  @map("is_mandatory")
  isReusable       Boolean  @default(false) @map("is_reusable")
  /// Nullable — null means "use the platform default", set explicitly only
  /// once a department confirms a different limit (FRD §37 #3, TBV).
  maxSizeBytes     Int?     @map("max_size_bytes")
  allowedMimeTypes String[] @default([]) @map("allowed_mime_types")
  description      String?

  approvalType ApprovalType @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  documents    Document[]

  @@index([approvalTypeId])
  @@map("document_requirements")
}

model DocumentVerification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  verifiedByUserId String    @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime  @default(now()) @map("verified_at")
  notes            String?
  validUntil       DateTime? @map("valid_until")

  document       Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  verifiedByUser User     @relation("DocumentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@map("document_verifications")
}

// ============================================================================
// WORKFLOW
// ============================================================================

model Workflow {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId String  @map("approval_type_id") @db.Uuid
  name           String
  version        Int
  isActive       Boolean @default(true) @map("is_active")

  approvalType       ApprovalType          @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  stages             WorkflowStage[]
  applications       ApprovalApplication[]
  schemeApplications SchemeApplication[]

  @@index([approvalTypeId])
  @@map("workflows")
}

enum WorkflowStageType {
  SCRUTINY
  INSPECTION
  DECISION

  @@map("workflow_stage_type")
}

model WorkflowStage {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId      String            @map("workflow_id") @db.Uuid
  sequenceOrder   Int               @map("sequence_order")
  name            String
  departmentId    String            @map("department_id") @db.Uuid
  stageType       WorkflowStageType @map("stage_type")
  /// NULL = "not yet configured" — never a guessed default (FRD §25.3).
  slaDays         Int?              @map("sla_days")
  /// Per-approval-type configuration flag, defaulting to false, because
  /// TRD §12 explicitly marks the "query pauses the SLA clock" convention
  /// as TBV rather than universally true — see architecture analysis §4
  /// item #3.
  slaPauseOnQuery Boolean           @default(false) @map("sla_pause_on_query")

  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  applicationStages ApplicationStage[]
  dependents        WorkflowStageDependency[] @relation("WorkflowStageDependencyStage")
  dependencies      WorkflowStageDependency[] @relation("WorkflowStageDependencyDependsOnStage")

  @@index([workflowId])
  @@map("workflow_stages")
}

/// Self-referencing join expressing "this stage cannot start until that
/// stage completes" — AND-only joins (a stage with multiple dependency rows
/// requires all of them), per the architecture analysis §13. Pure glue, no
/// independent meaning, cascades with either side.
model WorkflowStageDependency {
  workflowStageId          String @map("workflow_stage_id") @db.Uuid
  dependsOnWorkflowStageId String @map("depends_on_workflow_stage_id") @db.Uuid

  workflowStage          WorkflowStage @relation("WorkflowStageDependencyStage", fields: [workflowStageId], references: [id], onDelete: Cascade)
  dependsOnWorkflowStage WorkflowStage @relation("WorkflowStageDependencyDependsOnStage", fields: [dependsOnWorkflowStageId], references: [id], onDelete: Cascade)

  @@id([workflowStageId, dependsOnWorkflowStageId])
  @@map("workflow_stage_dependencies")
}

model OfficerDelegation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromOfficerId String   @map("from_officer_id") @db.Uuid
  toOfficerId   String   @map("to_officer_id") @db.Uuid
  departmentId  String   @map("department_id") @db.Uuid
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  reason        String
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  fromOfficer User       @relation("OfficerDelegationFrom", fields: [fromOfficerId], references: [id], onDelete: Restrict)
  toOfficer   User       @relation("OfficerDelegationTo", fields: [toOfficerId], references: [id], onDelete: Restrict)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  creator     User       @relation("OfficerDelegationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("officer_delegations")
}

// ============================================================================
// INSPECTION
// ============================================================================

enum InspectionStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED

  @@map("inspection_status")
}

model Inspection {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationStageId String           @map("application_stage_id") @db.Uuid
  inspectorId        String           @map("inspector_id") @db.Uuid
  scheduledAt        DateTime?        @map("scheduled_at")
  status             InspectionStatus @default(PENDING)
  siteAddress        String           @map("site_address")
  /// TRD §10.1 flags geo-tagging as legally/consent-sensitive and TBV —
  /// defaults to false; geo capture is never assumed permitted.
  geoConsentGiven    Boolean          @default(false) @map("geo_consent_given")

  applicationStage ApplicationStage   @relation(fields: [applicationStageId], references: [id], onDelete: Restrict)
  inspector        User               @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  reports          InspectionReport[]

  @@index([inspectorId])
  @@index([scheduledAt])
  @@map("inspections")
}

model InspectionChecklist {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId String @map("approval_type_id") @db.Uuid
  itemText       String @map("item_text")
  sequenceOrder  Int    @map("sequence_order")

  approvalType ApprovalType       @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  reports      InspectionReport[]

  @@index([approvalTypeId])
  @@map("inspection_checklists")
}

enum InspectionFinding {
  COMPLIANT
  NON_COMPLIANT
  CONDITIONAL

  @@map("inspection_finding")
}

model InspectionReport {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId       String            @map("inspection_id") @db.Uuid
  checklistItemId    String            @map("checklist_item_id") @db.Uuid
  response           String
  evidenceDocumentId String?           @map("evidence_document_id") @db.Uuid
  finding            InspectionFinding
  notes              String?

  inspection       Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  checklistItem    InspectionChecklist @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  evidenceDocument Document?           @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@map("inspection_reports")
}

enum InspectorConflictStatus {
  DECLARED
  CLEARED
  CONFIRMED

  @@map("inspector_conflict_status")
}

model InspectorConflict {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectorId String                  @map("inspector_id") @db.Uuid
  projectId   String                  @map("project_id") @db.Uuid
  declaredAt  DateTime                @default(now()) @map("declared_at")
  reviewedBy  String?                 @map("reviewed_by") @db.Uuid
  status      InspectorConflictStatus @default(DECLARED)

  inspector User    @relation("InspectorConflictInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  reviewer  User?   @relation("InspectorConflictReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("inspector_conflicts")
}

