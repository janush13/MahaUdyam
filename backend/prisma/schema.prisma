// COMPLIANCE AND RENEWAL
// ============================================================================

enum ComplianceFrequency {
  ONE_TIME
  MONTHLY
  ANNUAL

  @@map("compliance_frequency")
}

model ComplianceRequirement {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approvalTypeId String              @map("approval_type_id") @db.Uuid
  description    String
  frequency      ComplianceFrequency

  approvalType ApprovalType       @relation(fields: [approvalTypeId], references: [id], onDelete: Restrict)
  records      ComplianceRecord[]

  @@index([approvalTypeId])
  @@map("compliance_requirements")
}

enum ComplianceRecordStatus {
  UPCOMING
  DUE
  OVERDUE
  FULFILLED

  @@map("compliance_record_status")
}

model ComplianceRecord {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId           String                 @map("application_id") @db.Uuid
  complianceRequirementId String                 @map("compliance_requirement_id") @db.Uuid
  dueDate                 DateTime               @map("due_date")
  status                  ComplianceRecordStatus @default(UPCOMING)
  fulfilledDocumentId     String?                @map("fulfilled_document_id") @db.Uuid

  application           ApprovalApplication   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  complianceRequirement ComplianceRequirement @relation(fields: [complianceRequirementId], references: [id], onDelete: Restrict)
  fulfilledDocument     Document?             @relation(fields: [fulfilledDocumentId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("compliance_records")
}

model Renewal {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  originalApplicationId String   @map("original_application_id") @db.Uuid
  newApplicationId      String?  @map("new_application_id") @db.Uuid
  renewalDueDate        DateTime @map("renewal_due_date")
  status                String
  /// Configurable reminder cadence (e.g. days-before-expiry) — deliberately
  /// not hard-coded to 90/60/30/7 per FRD §37 #9 (exact cadence is TBV).
  reminderSchedule      Json     @map("reminder_schedule") @db.JsonB
  createdAt             DateTime @default(now()) @map("created_at")

  originalApplication ApprovalApplication  @relation("RenewalOriginalApplication", fields: [originalApplicationId], references: [id], onDelete: Restrict)
  newApplication      ApprovalApplication? @relation("RenewalNewApplication", fields: [newApplicationId], references: [id], onDelete: Restrict)

  @@map("renewals")
}

// ============================================================================
// SCHEMES
// ============================================================================

enum SchemePublishStatus {
  DRAFT
  PUBLISHED

  @@map("scheme_publish_status")
}

model Scheme {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  departmentId  String              @map("department_id") @db.Uuid
  description   String
  benefits      String
  isActive      Boolean             @default(true) @map("is_active")
  publishStatus SchemePublishStatus @default(DRAFT) @map("publish_status")

  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  rules        SchemeRule[]
  applications SchemeApplication[]

  @@index([departmentId])
  @@map("schemes")
}

model SchemeRule {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId      String    @map("scheme_id") @db.Uuid
  version       Int
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")
  conditions    Json      @db.JsonB

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)

  @@index([schemeId])
  @@map("scheme_rules")
}

model SchemeApplication {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemeId        String    @map("scheme_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  workflowId      String    @map("workflow_id") @db.Uuid
  /// Status vocabulary intentionally free text at the schema layer (mirrors
  /// approval_applications' general application state pattern per
  /// Blueprint §15) — the concrete enum/state machine for scheme
  /// applications is service-layer logic for a later step, not schema.
  status          String
  submittedAt     DateTime? @map("submitted_at")
  decidedAt       DateTime? @map("decided_at")
  referenceNumber String?   @unique @map("reference_number")

  scheme   Scheme   @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@map("scheme_applications")
}

